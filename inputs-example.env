# Per-input config — copied to /etc/nexrec/inputs/<id>.env by setup.
# The Inputs page is the day-to-day editor; this file is the systemd EnvironmentFile.
# Sourced by nexrec-record@.service AFTER nexrec.env. Quote values with spaces.
# Up to 10 concurrent inputs per host (NEXREC_MAX_INPUTS).

# Stable slug (also the systemd instance name). [a-z0-9-]{1,32}
INPUT_ID=demo
INPUT_NAME="Demo color bars"

# rtsp | srt | udp | tcp | rtp | decklink | testsrc
SOURCE_TYPE=testsrc

# IP URL examples (do not commit credentials):
#   rtsp://user:pass@encoder.example.internal:554/stream1
#   srt://encoder.example.internal:9000?mode=caller
#   udp://239.1.1.1:5000
#   tcp://10.10.10.10:5000
#   rtp://239.1.1.2:5004
SOURCE_URL=

# DeckLink SDI (Blackmagic drivers + FFmpeg --enable-decklink).
# Names match `ffmpeg -f decklink -list_devices`: DeckLink Quad 2 (1), DeckLink Duo (1).
# A bare index (0, 1, …) is resolved at record start. Preview is teed in
# nexrec-record — do not enable nexrec-preview@ for this input.
# DECKLINK_DEVICE=DeckLink Quad 2 (1)
# DECKLINK_FORMAT=Hi59   # optional format_code; blank = auto
# KEEP_INTERLACE=1       # 1080i stays 1080i unless UPCONVERT_1080I=1

# 1 = always decode+encode to broadcast H.264+AAC MP4 (needed for some IP flavors)
# 0 = copy bitstream when the source is already H.264 4:2:0 + AAC
LIVE_TRANSCODE=1
COPY_NATIVE=0

# 1 = keep interlaced raster (1080i stays 1080i). DeckLink defaults on in the
# encoder assembler; IP progressive should leave this 0.
KEEP_INTERLACE=0


# Override station-wide broadcast bitrate for this input (blank = inherit).
# VIDEO_BITRATE=12M
# AUDIO_BITRATE=192k

# Native/raw chunk retention in days (default 28 = 4 weeks).
RETENTION_DAYS=28

# MediaMTX path for WebRTC preview (in0..in9). Preview is proxy quality.
PREVIEW_PATH=in0
PREVIEW_ENABLED=1

# 1 = record, 0 = configured but parked
ENABLED=1

# NexClip Mode 2 slot (1–8). Blank = local-only, not reported on check-in.
# NEXCLIP_SLOT=1

# --- Monitoring / intelligence (sidecar; does not change the MP4 record path) -
# All default off. Thresholds are seconds the condition must persist before log.
FEAT_SCTE=0
FEAT_AV_ANOMALY=0
FEAT_CAPTIONS=0
FEAT_TRANSCRIBE=0
# 1 = log Nielsen watermark presence (present/absent) on the recording timeline.
# Best-effort stub. Not audit-grade decode. No SID / watermark time / layer.
FEAT_NIELSEN=0
FEAT_MONITORS=0
THRESH_FREEZE_S=2
THRESH_BLACK_S=2
THRESH_BARS_S=5
# TRANSCRIBE_ENGINE=whisper.cpp
