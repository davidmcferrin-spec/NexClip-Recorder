          "cookies": [],
          "content": {
            "size": 6825,
            "mimeType": "text/html",
            "compression": 4302,
            "text": "<!DOCTYPE html>\n<html lang=\"en\" data-theme=\"dark\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>NexCLIP Recorder — Setup</title>\n<link rel=\"stylesheet\" href=\"/assets/nexrec.css\">\n<script src=\"/assets/nexrec-ui.js\"></script>\n</head>\n<body>\n<nav class=\"topnav\">\n  <a class=\"brand\" href=\"/live\">NexCLIP Recorder</a>\n  <a href=\"/live\">Live</a>\n  <a href=\"/export\">Export</a>\n  <a href=\"/metrics\" data-auth-role=\"admin,operator\">Metrics</a>\n  <a href=\"/inputs\" data-auth-role=\"admin,operator\">Inputs</a>\n  <a class=\"active\" href=\"/settings\" data-auth-role=\"admin,operator\">Setup</a>\n  <a href=\"/users\" data-auth-role=\"admin\">Users</a>\n  <a href=\"/services\" data-auth-role=\"admin\">Services</a>\n  <button type=\"button\" class=\"theme-toggle\" id=\"theme-toggle\">Light</button>\n  <span class=\"nav-version\" id=\"nav-version\" hidden></span>\n  <span class=\"nav-who\" id=\"nav-who\" hidden></span>\n  <button type=\"button\" class=\"nav-logout\" id=\"nav-logout\">Log out</button>\n</nav>\n<main>\n  <div class=\"bar\">\n    <h1 style=\"margin:0\">Setup / Configuration</h1>\n    <button type=\"button\" class=\"primary\" id=\"save\" hidden>Save</button>\n    <span class=\"ok-msg\" id=\"msg\"></span>\n  </div>\n  <p class=\"sub\" id=\"policy\"></p>\n  <div id=\"sections\"></div>\n  <div class=\"panel\">\n    <h2>Bootstrap and secrets</h2>\n    <p class=\"sub\">These stay in <code>nexrec.env</code>. This page never shows secret values. Change them on the host, then restart the units that read them.</p>\n    <table><tbody id=\"secrets\"></tbody></table>\n  </div>\n  <div class=\"panel\" id=\"pem-panel\" hidden>\n    <h2>Paste NexAPP JWT public key</h2>\n    <p class=\"sub\">Optional. Writes a PEM under the data auth directory and points <code>nexapp.public_key_path</code> at that file. The key is not stored in SQLite.</p>\n    <textarea id=\"pem\" rows=\"6\" placeholder=\"-----BEGIN PUBLIC KEY-----\"></textarea>\n  </div>\n  <div class=\"panel\">\n    <h2>Runtime status</h2>\n    <pre class=\"meta\" id=\"status\" style=\"white-space:pre-wrap\"></pre>\n  </div>\n</main>\n<script src=\"/assets/nexrec-auth-gate.js\"></script>\n<script>\nvar CAN_EDIT = false;\nNexRecAuth.requirePage({ roles: [\"admin\", \"operator\"] }).then(function (user) {\n  CAN_EDIT = user && user.role === \"admin\";\n  return load();\n});\n\nfunction esc(s) {\n  return String(s == null ? \"\" : s).replace(/[&<>\"']/g, function (c) {\n    return { \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c];\n  });\n}\nfunction fieldInput(f) {\n  var id = \"f-\" + f.key.replace(/[^a-z0-9]+/gi, \"-\");\n  var dis = CAN_EDIT ? \"\" : \" disabled\";\n  if (f.type === \"bool\") {\n    var on = f.value === \"1\" || f.value === \"true\";\n    return '<label class=\"check\"><input type=\"checkbox\" id=\"' + id + '\" data-key=\"' + esc(f.key) + '\" data-type=\"bool\"' +\n      (on ? \" checked\" : \"\") + dis + \"> \" + esc(f.label) + \"</label>\";\n  }\n  if (f.type === \"enum\") {\n    var opts = (f.options || []).map(function (o) {\n      return '<option value=\"' + esc(o) + '\"' + (o === f.value ? \" selected\" : \"\") + \">\" + esc(o) + \"</option>\";\n    }).join(\"\");\n    return '<label>' + esc(f.label) + '</label><select id=\"' + id + '\" data-key=\"' + esc(f.key) + '\"' + dis + \">\" + opts + \"</select>\";\n  }\n  if (f.type === \"text\" || f.type === \"command\") {\n    return '<label>' + esc(f.label) + '</label><textarea id=\"' + id + '\" data-key=\"' + esc(f.key) + '\" rows=\"3\"' + dis + \">\" +\n      esc(f.value || \"\") + \"</textarea>\";\n  }\n  var shown = f.value || \"\";\n  var extra = \"\";\n  if (f.ui === \"minutes\") {\n    var sec = Number(f.value || 0);\n    shown = String(Math.round((sec / 60) * 100) / 100);\n    extra = ' data-ui=\"minutes\"';\n  }\n  var inputType = (f.type === \"int\") ? \"number\" : \"text\";\n  return '<label>' + esc(f.label) + '</label><input type=\"' + inputType + '\" id=\"' + id + '\" data-key=\"' + esc(f.key) + '\"' +\n    extra + ' value=\"' + esc(shown) + '\"' + dis + \">\";\n}\nfunction render(data) {\n  document.getElementById(\"policy\").textContent = data.policy || \"\";\n  document.getElementById(\"save\").hidden = !data.can_edit;\n  document.getElementById(\"pem-panel\").hidden = !data.can_edit;\n  var host = document.getElementById(\"sections\");\n  host.innerHTML = \"\";\n  var groups = {};\n  var order = [];\n  (data.fields || []).forEach(function (f) {\n    if (!groups[f.section]) {\n      groups[f.section] = [];\n      order.push(f.section);\n    }\n    groups[f.section].push(f);\n  });\n  order.forEach(function (sec) {\n    var panel = document.createElement(\"div\");\n    panel.className = \"panel\";\n    var title = (groups[sec][0] && groups[sec][0].section_label) || sec;\n    var html = \"<h2>\" + esc(title) + \"</h2>\";\n    groups[sec].forEach(function (f) {\n      html += '<div class=\"setup-field\">' + fieldInput(f);\n      if (f.help && f.type !== \"bool\") html += '<p class=\"sub\">' + esc(f.help) + \"</p>\";\n      else if (f.help && f.type === \"bool\") html += '<p class=\"sub\">' + esc(f.help) + \"</p>\";\n      html += \"</div>\";\n    });\n    panel.innerHTML = html;\n    host.appendChild(panel);\n  });\n  var sb = document.getElementById(\"secrets\");\n  sb.innerHTML = \"\";\n  (data.secrets || []).forEach(function (s) {\n    var tr = document.createElement(\"tr\");\n    tr.innerHTML = \"<th>\" + esc(s.key) + \"</th><td>\" + (s.set ? \"set\" : \"not set\") +\n      \"</td><td class='sub'>\" + esc(s.note || \"\") + \"</td>\";\n    sb.appendChild(tr);\n  });\n}\nfunction collect() {\n  var settings = {};\n  document.querySelectorAll(\"[data-key]\").forEach(function (el) {\n    var key = el.getAttribute(\"data-key\");\n    if (el.getAttribute(\"data-type\") === \"bool\" || el.type === \"checkbox\") {\n      settings[key] = el.checked ? \"1\" : \"0\";\n      return;\n    }\n    if (el.getAttribute(\"data-ui\") === \"minutes\") {\n      var sec = Math.round(Number(el.value) * 60);\n      if (!isFinite(sec) || sec < 1) sec = 300;\n      settings[key] = String(sec);\n      return;\n    }\n    settings[key] = el.value;\n  });\n  var pem = document.getElementById(\"pem\").value.trim();\n  if (pem) settings[\"nexapp.public_key_pem\"] = pem;\n  return settings;\n}\nfunction load() {\n  return Promise.all([\n    NexRecAuth.recApi(\"settings_get\"),\n    NexRecAuth.recApi(\"status\")\n  ]).then(function (all) {\n    render(all[0]);\n    document.getElementById(\"status\").textContent = JSON.stringify(all[1], null, 2);\n  });\n}\ndocument.getElementById(\"save\").onclick = function () {\n  var msg = document.getElementById(\"msg\");\n  msg.textContent = \"saving…\";\n  msg.className = \"sub\";\n  NexRecAuth.recApi(\"settings_patch\", { settings: collect() }).then(function () {\n    msg.className = \"ok-msg\";\n    msg.textContent = \"Saved. Restart record / cleanup / nexclip units to pick up path and encode changes.\";\n    document.getElementById(\"pem\").value = \"\";\n    return load();\n  }).catch(function (e) {\n    msg.className = \"err\";\n    msg.textContent = e.message || \"save failed\";\n  });\n};\n</script>\n</body>\n</html>\n"
          },
          "redirectURL": "",
          "headersSize": 368,
          "bodySize": 2523,
