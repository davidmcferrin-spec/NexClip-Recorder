          "cookies": [],
          "content": {
            "size": 12941,
            "mimeType": "text/html",
            "compression": 8727,
            "text": "<!DOCTYPE html>\n<html lang=\"en\" data-theme=\"dark\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>NexCLIP Recorder — Metrics</title>\n<link rel=\"stylesheet\" href=\"/assets/nexrec.css\">\n<script src=\"/assets/nexrec-ui.js\"></script>\n</head>\n<body>\n<nav class=\"topnav\">\n  <a class=\"brand\" href=\"/live\">NexCLIP Recorder</a>\n  <a href=\"/live\">Live</a>\n  <a href=\"/export\">Export</a>\n  <a class=\"active\" href=\"/metrics\" data-auth-role=\"admin,operator\">Metrics</a>\n  <a href=\"/inputs\" data-auth-role=\"admin,operator\">Inputs</a>\n  <a href=\"/settings\" data-auth-role=\"admin,operator\">Setup</a>\n  <a href=\"/users\" data-auth-role=\"admin\">Users</a>\n  <a href=\"/services\" data-auth-role=\"admin\">Services</a>\n  <button type=\"button\" class=\"theme-toggle\" id=\"theme-toggle\">Light</button>\n  <span class=\"nav-version\" id=\"nav-version\" hidden></span>\n  <span class=\"nav-who\" id=\"nav-who\" hidden></span>\n  <button type=\"button\" class=\"nav-logout\" id=\"nav-logout\">Log out</button>\n</nav>\n<main>\n  <div class=\"bar\">\n    <h1 style=\"margin:0\">Metrics</h1>\n    <label class=\"meta\" style=\"margin:0\">Range\n      <select id=\"hours\">\n        <option value=\"6\">6 hours</option>\n        <option value=\"24\" selected>24 hours</option>\n        <option value=\"72\">3 days</option>\n        <option value=\"168\">7 days</option>\n      </select>\n    </label>\n    <button type=\"button\" id=\"refresh\">Refresh</button>\n    <span class=\"sub\" id=\"hint\"></span>\n  </div>\n  <div class=\"metric-grid\" id=\"cards\"></div>\n  <div class=\"panel\">\n    <h2>Drive</h2>\n    <p class=\"sub\" id=\"drive-summary\">Filesystem that holds the recordings path. Samples are about a minute apart.</p>\n    <div class=\"drive-chart\" id=\"drive-chart\"></div>\n    <table>\n      <thead>\n        <tr><th>Time</th><th>Path</th><th>Used</th><th>Free</th><th>Total</th><th>%</th></tr>\n      </thead>\n      <tbody id=\"drive\"></tbody>\n    </table>\n    <h2>Days left</h2>\n    <p class=\"sub\" id=\"runway-summary\">Each input’s days left is how long that input alone would take to fill the space remaining before purge. The system line is all enabled inputs writing together.</p>\n    <table>\n      <thead>\n        <tr><th>Input</th><th>Rate</th><th>On disk</th><th>Retention</th><th>Days left alone</th></tr>\n      </thead>\n      <tbody id=\"runway\"></tbody>\n    </table>\n  </div>\n  <div class=\"panel\">\n    <h2>SDI lock</h2>\n    <p class=\"sub\">Each mark is one sample, about a minute apart. Green is locked, red is unlocked. The recorder writes the current lock on the Services page; this log is the history.</p>\n    <table>\n      <thead>\n        <tr><th>Input</th><th>Now</th><th>Format</th><th>History</th></tr>\n      </thead>\n      <tbody id=\"sdi\"></tbody>\n    </table>\n  </div>\n</main>\n<script src=\"/assets/nexrec-auth-gate.js\"></script>\n<script>\nNexRecAuth.requirePage({ roles: [\"admin\", \"operator\"] }).then(load);\n\nfunction esc(s) {\n  return String(s == null ? \"\" : s).replace(/[&<>\"']/g, function (c) {\n    return { \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c];\n  });\n}\nfunction pct(used, total) {\n  if (used == null || total == null || !Number(total)) return null;\n  return Math.round((Number(used) / Number(total)) * 1000) / 10;\n}\nfunction gib(bytes) {\n  if (bytes == null || bytes === \"\") return \"—\";\n  var n = Number(bytes);\n  if (!isFinite(n)) return \"—\";\n  return (n / (1024 * 1024 * 1024)).toFixed(1) + \" GiB\";\n}\nfunction spark(values) {\n  var w = 240, h = 36;\n  var nums = values.filter(function (v) { return v != null && isFinite(v); });\n  if (!nums.length) return \"\";\n  var min = Math.min.apply(null, nums);\n  var max = Math.max.apply(null, nums);\n  if (max === min) max = min + 1;\n  var step = values.length > 1 ? w / (values.length - 1) : w;\n  var d = [];\n  values.forEach(function (v, i) {\n    if (v == null || !isFinite(Number(v))) return;\n    var x = i * step;\n    var y = h - ((Number(v) - min) / (max - min)) * (h - 4) - 2;\n    d.push((d.length ? \"L\" : \"M\") + x.toFixed(1) + \" \" + y.toFixed(1));\n  });\n  if (!d.length) return \"\";\n  return '<svg viewBox=\"0 0 ' + w + ' ' + h + '\" class=\"spark\" preserveAspectRatio=\"none\"><path d=\"' + d.join(\" \") + '\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg>';\n}\nfunction card(label, value, series) {\n  return '<div class=\"metric-card\"><div class=\"sub\">' + esc(label) + '</div><div class=\"val\">' + esc(value) + '</div>' + spark(series) + '</div>';\n}\nfunction diskRows(host) {\n  return host.filter(function (r) {\n    return r.disk_total_bytes != null && r.disk_total_bytes !== \"\" && Number(r.disk_total_bytes) > 0;\n  });\n}\nfunction downsample(rows, max) {\n  if (rows.length <= max) return rows.slice();\n  var out = [];\n  var step = (rows.length - 1) / (max - 1);\n  var last = -1;\n  for (var i = 0; i < max; i++) {\n    var idx = Math.round(i * step);\n    if (idx !== last) out.push(rows[idx]);\n    last = idx;\n  }\n  return out;\n}\nfunction driveChart(rows) {\n  var box = document.getElementById(\"drive-chart\");\n  if (!rows.length) {\n    box.innerHTML = \"\";\n    return;\n  }\n  var w = 1000, h = 160, pad = 28;\n  var step = rows.length > 1 ? (w - pad * 2) / (rows.length - 1) : 0;\n  var d = [];\n  rows.forEach(function (r, i) {\n    var p = pct(r.disk_used_bytes, r.disk_total_bytes);\n    if (p == null) return;\n    var x = pad + i * step;\n    var y = pad + (1 - p / 100) * (h - pad * 2);\n    d.push((d.length ? \"L\" : \"M\") + x.toFixed(1) + \" \" + y.toFixed(1));\n  });\n  var axis = \"\";\n  [0, 50, 100].forEach(function (mark) {\n    var y = pad + (1 - mark / 100) * (h - pad * 2);\n    axis += '<line x1=\"' + pad + '\" y1=\"' + y.toFixed(1) + '\" x2=\"' + (w - 8) + '\" y2=\"' + y.toFixed(1) + '\" stroke=\"#2a3542\" stroke-width=\"1\"/>';\n    axis += '<text x=\"4\" y=\"' + (y + 4).toFixed(1) + '\" fill=\"#9aa8b5\" font-size=\"12\">' + mark + '</text>';\n  });\n  box.innerHTML = '<svg viewBox=\"0 0 ' + w + ' ' + h + '\" role=\"img\" aria-label=\"Drive used percent\">' +\n    axis +\n    (d.length ? '<path d=\"' + d.join(\" \") + '\" fill=\"none\" stroke=\"#3ecf8e\" stroke-width=\"2\"/>' : \"\") +\n    \"</svg>\";\n}\nfunction paintDrive(host) {\n  var rows = diskRows(host);\n  var summary = document.getElementById(\"drive-summary\");\n  var body = document.getElementById(\"drive\");\n  driveChart(rows);\n  if (!rows.length) {\n    summary.textContent = \"No disk samples yet. The metrics timer writes one about once a minute.\";\n    body.innerHTML = '<tr><td colspan=\"6\">No disk samples yet.</td></tr>';\n    return;\n  }\n  var last = rows[rows.length - 1];\n  var used = Number(last.disk_used_bytes);\n  var total = Number(last.disk_total_bytes);\n  var free = Math.max(0, total - used);\n  var p = pct(used, total);\n  summary.textContent = (last.disk_path || \"recordings path\") + \" · \" +\n    (p == null ? \"—\" : p + \"% used\") + \" · \" + gib(free) + \" free of \" + gib(total);\n  body.innerHTML = downsample(rows, 24).slice().reverse().map(function (r) {\n    var u = Number(r.disk_used_bytes);\n    var t = Number(r.disk_total_bytes);\n    var f = Math.max(0, t - u);\n    var when = window.NexRecUI && NexRecUI.formatStation ? NexRecUI.formatStation(r.sampled_at, true) : (r.sampled_at || \"—\");\n    var pp = pct(u, t);\n    return \"<tr><td>\" + esc(when) + \"</td><td>\" + esc(r.disk_path || \"—\") +\n      \"</td><td>\" + esc(gib(u)) + \"</td><td>\" + esc(gib(f)) + \"</td><td>\" + esc(gib(t)) +\n      \"</td><td>\" + esc(pp == null ? \"—\" : pp + \"%\") + \"</td></tr>\";\n  }).join(\"\");\n}\nfunction lockCell(v) {\n  if (v === 1 || v === \"1\") return '<i class=\"on\" title=\"locked\"></i>';\n  if (v === 0 || v === \"0\") return '<i class=\"off\" title=\"unlocked\"></i>';\n  return '<i title=\"unknown\"></i>';\n}\nfunction paint(data) {\n  var host = data.host || [];\n  var last = host.length ? host[host.length - 1] : {};\n  var cpu = last.cpu_pct == null ? \"—\" : Number(last.cpu_pct).toFixed(1) + \"%\";\n  var memP = pct(last.mem_used_bytes, last.mem_total_bytes);\n  var diskP = pct(last.disk_used_bytes, last.disk_total_bytes);\n  var gpu = last.gpu_util_pct == null ? \"—\" : Number(last.gpu_util_pct).toFixed(0) + \"%\";\n  var enc = last.gpu_enc_pct == null ? \"\" : \" enc \" + Number(last.gpu_enc_pct).toFixed(0) + \"%\";\n  document.getElementById(\"cards\").innerHTML = [\n    card(\"CPU\", cpu, host.map(function (r) { return r.cpu_pct == null ? null : Number(r.cpu_pct); })),\n    card(\"Memory\", memP == null ? \"—\" : memP + \"% · \" + gib(last.mem_used_bytes), host.map(function (r) { return pct(r.mem_used_bytes, r.mem_total_bytes); })),\n    card(\"Disk\", diskP == null ? \"—\" : diskP + \"% · \" + gib(last.disk_used_bytes) + \" used\", host.map(function (r) { return pct(r.disk_used_bytes, r.disk_total_bytes); })),\n    card(\"GPU\" + (last.gpu_name ? \" · \" + last.gpu_name : \"\"), gpu + enc, host.map(function (r) { return r.gpu_util_pct == null ? null : Number(r.gpu_util_pct); })),\n  ].join(\"\");\n  paintDrive(host);\n  var byInput = {};\n  (data.sdi || []).forEach(function (row) {\n    if (!byInput[row.input_id]) byInput[row.input_id] = [];\n    byInput[row.input_id].push(row);\n  });\n  var names = {};\n  (data.signals || []).forEach(function (row) {\n    names[row.input_id] = row;\n    if (!byInput[row.input_id]) byInput[row.input_id] = [];\n  });\n  var ids = Object.keys(byInput).sort();\n  var body = document.getElementById(\"sdi\");\n  if (!ids.length) {\n    body.innerHTML = '<tr><td colspan=\"4\">No SDI samples yet.</td></tr>';\n  } else {\n    body.innerHTML = ids.map(function (id) {\n      var hist = byInput[id];\n      var now = names[id] || hist[hist.length - 1] || {};\n      var recent = hist.slice(-120);\n      var strip = '<span class=\"lock-strip\">' + recent.map(function (row) { return lockCell(row.sdi_lock); }).join(\"\") + \"</span>\";\n      var state = now.sdi_lock === 1 || now.sdi_lock === \"1\" ? \"locked\" : (now.sdi_lock === 0 || now.sdi_lock === \"0\" ? \"unlocked\" : (now.signal || \"unknown\"));\n      return \"<tr><td>\" + esc(id) + \"</td><td>\" + esc(state) + \"</td><td>\" + esc(now.format || \"—\") + \"</td><td>\" + strip + \"</td></tr>\";\n    }).join(\"\");\n  }\n  var hint = host.length ? (host.length + \" samples · latest \" + host[host.length - 1].sampled_at) : \"No samples yet.\";\n  if (data.pending) hint += \" The metrics timer has not created the log tables yet.\";\n  document.getElementById(\"hint\").textContent = hint;\n}\nfunction daysLabel(v) {\n  if (v == null || v === \"\") return \"—\";\n  var n = Number(v);\n  if (!isFinite(n)) return \"—\";\n  if (n < 0.05) return \"under 0.1\";\n  return n.toFixed(1);\n}\nfunction rateLabel(bps, source) {\n  var n = Number(bps);\n  if (!isFinite(n) || n <= 0) return \"—\";\n  var mbps = (n * 8) / 1000000;\n  var shown = mbps >= 10 ? mbps.toFixed(1) : mbps.toFixed(2);\n  var kind = source === \"measured\" ? \" measured\" : (source === \"bitrate\" ? \" target\" : \"\");\n  return shown + \" Mb/s\" + kind;\n}\nfunction paintRunway(data) {\n  var summary = document.getElementById(\"runway-summary\");\n  var body = document.getElementById(\"runway\");\n  if (!summary || !body) return;\n  var rows = data.inputs || [];\n  var sys = daysLabel(data.system_days);\n  var usable = gib(data.usable_bytes);\n  summary.textContent = \"Space left before purge is \" + usable +\n    \". All enabled inputs together: \" + (data.system_days == null ? \"not projected yet\" : sys + \" days\") +\n    \". A row’s days left is that input alone. Purge starts at \" + (data.max_used_percent || \"—\") +\n    \"% used, and the warning bar appears \" + (data.warn_points || \"—\") + \" points sooner.\";\n  if (!rows.length) {\n    body.innerHTML = '<tr><td colspan=\"5\">No inputs yet.</td></tr>';\n    return;\n  }\n  var html = rows.map(function (r) {\n    return \"<tr><td>\" + esc(r.name || r.id) + \"</td><td>\" + esc(rateLabel(r.rate_bps, r.rate_source)) +\n      \"</td><td>\" + esc(daysLabel(r.days_on_disk)) + \"</td><td>\" + esc(r.retention_days) +\n      \"</td><td>\" + esc(daysLabel(r.days_left)) + \"</td></tr>\";\n  }).join(\"\");\n  html += \"<tr><td>All inputs</td><td>\" + esc(rateLabel(data.system_rate_bps, \"\")) +\n    \"</td><td>—</td><td>—</td><td>\" + esc(sys) + \"</td></tr>\";\n  body.innerHTML = html;\n}\nfunction loadForecast() {\n  if (!window.NexRecAuth || !NexRecAuth.recApi) return;\n  NexRecAuth.recApi(\"storage_forecast\").then(paintRunway).catch(function () {\n    var body = document.getElementById(\"runway\");\n    if (body) body.innerHTML = '<tr><td colspan=\"5\">Days left unavailable.</td></tr>';\n  });\n}\nfunction load() {\n  loadForecast();\n  var hours = document.getElementById(\"hours\").value;\n  return fetch(\"/api/recorder?action=metrics_list&hours=\" + encodeURIComponent(hours), { credentials: \"same-origin\" })\n    .then(function (r) { return r.json(); })\n    .then(function (data) {\n      if (!data.ok) throw new Error(data.error || \"metrics failed\");\n      paint(data);\n    })\n    .catch(function (err) {\n      document.getElementById(\"hint\").textContent = err.message || String(err);\n    });\n}\ndocument.getElementById(\"refresh\").addEventListener(\"click\", load);\ndocument.getElementById(\"hours\").addEventListener(\"change\", load);\nsetInterval(load, 60000);\n</script>\n</body>\n</html>\n"
