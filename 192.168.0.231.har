            "text": "@import url(\"./nexapp-tokens.css\");\n\n:root {\n  --bg: var(--nx-bg, #0b0f14);\n  --panel: var(--nx-surface, #151b23);\n  --edge: var(--nx-line, #2a3542);\n  --text: var(--nx-ink, #e8eef4);\n  --dim: var(--nx-muted, #9aa8b5);\n  --muted: var(--nx-muted, #9aa8b5);\n  --ok: var(--nx-ok, #3ecf8e);\n  --bad: var(--nx-danger, #f87171);\n  --warn: var(--nx-warn, #f5a524);\n  --acc: var(--nx-accent, #3ecf8e);\n  --on-acc: #08131a;\n}\n\n* { box-sizing: border-box; }\nhtml, body { margin: 0; background: var(--bg); color: var(--text); }\nbody {\n  min-height: 100vh;\n  font: 14px/1.45 var(--nx-font, \"IBM Plex Sans\", sans-serif);\n  display: flex; flex-direction: column;\n}\nnav.topnav {\n  display: flex; flex-wrap: wrap; align-items: center; gap: 4px;\n  padding: 10px 16px; background: var(--panel); border-bottom: 1px solid var(--edge);\n  position: relative;\n}\n.space-warn {\n  flex: 0 0 auto;\n  background: #6b2a12;\n  color: #fff8f3;\n  padding: 8px 16px;\n  border-bottom: 1px solid var(--warn);\n}\n.space-warn[hidden] { display: none; }\n.nav-bell { position: relative; }\n.notice-badge {\n  margin-left: 6px; background: var(--acc); color: var(--on-acc);\n  border-radius: 9px; padding: 0 6px; font-size: 11px;\n}\n.notice-panel {\n  position: absolute; right: 12px; top: 46px; width: min(360px, calc(100vw - 24px));\n  background: var(--panel); border: 1px solid var(--edge); border-radius: 6px;\n  z-index: 30; padding: 8px 10px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);\n}\n.notice-panel[hidden] { display: none; }\n.notice-panel p { margin: 8px 0; }\n.notice-panel a.notice-link {\n  display: inline; padding: 0 4px 0 0; color: var(--acc); border: 0; font-weight: 600;\n}\ntr.job-focus { outline: 2px solid var(--acc); }\nnav.topnav .brand {\n  color: var(--acc); font-weight: 600; text-decoration: none; font-size: 15px;\n  padding: 6px 12px 6px 0; margin-right: 4px;\n}\nnav.topnav a {\n  color: var(--muted); text-decoration: none; padding: 6px 12px;\n  border-radius: 4px; border: 1px solid transparent;\n}\nnav.topnav a:hover { color: var(--text); border-color: var(--edge); }\nnav.topnav a.active {\n  background: var(--acc); color: var(--on-acc); border-color: var(--acc); font-weight: 600;\n}\nnav.topnav .theme-toggle, nav.topnav .nav-logout {\n  background: var(--bg); color: var(--text);\n  border: 1px solid var(--edge); border-radius: 4px; padding: 6px 10px;\n  font: inherit; font-size: 12px; cursor: pointer;\n}\nnav.topnav .theme-toggle { margin-left: auto; }\nnav.topnav .nav-who { color: var(--dim); font-size: 12px; margin-left: 8px; }\n.nav-version {\n  margin-left: 6px; padding: 4px 8px; border: 1px solid var(--edge); border-radius: 4px;\n  color: var(--dim); font-size: 11px;\n}\nmain { padding: 16px; flex: 1; min-height: 0; display: flex; flex-direction: column; }\nh1 { font-size: 16px; margin: 0 0 12px; color: var(--acc); }\n.sub, .meta, .empty { color: var(--dim); font-size: 13px; }\n.err { color: var(--bad); font-size: 12px; }\n.ok-msg { color: var(--ok); font-size: 12px; }\n.panel {\n  background: var(--panel); border: 1px solid var(--edge);\n  border-radius: var(--nx-radius, 10px); padding: 14px; margin-bottom: 12px;\n}\n.bar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 12px; }\n.bar input.listen-vol { width: 96px; flex: 0 0 96px; padding: 0 4px; }\n.bar input.range-time {\n  width: 12.5rem; flex: 0 0 auto; font-family: var(--nx-mono); font-size: 12px;\n}\n.timeline-scale {\n  display: flex; justify-content: space-between; gap: 12px;\n  font-family: var(--nx-mono); font-size: 11px; color: var(--dim); margin: -4px 0 8px;\n}\nlabel { display: block; font-size: 12px; color: var(--muted); margin: 8px 0 4px; }\ninput, select, textarea, button {\n  background: var(--bg); color: var(--text); border: 1px solid var(--edge);\n  border-radius: 6px; padding: 8px 10px; font: inherit;\n}\ninput:focus, select:focus { outline: none; border-color: var(--acc); }\nbutton { cursor: pointer; }\nbutton.primary {\n  background: var(--acc); color: var(--on-acc); border-color: var(--acc); font-weight: 600;\n}\nbutton.tgl.active, .seg button.active {\n  background: var(--acc); color: var(--on-acc); border-color: var(--acc); font-weight: 600;\n}\n.seg { display: inline-flex; border: 1px solid var(--edge); border-radius: 6px; overflow: hidden; }\n.seg button { border: none; border-radius: 0; border-right: 1px solid var(--edge); }\n.seg button:last-child { border-right: none; }\ntable { width: 100%; border-collapse: collapse; font-size: 13px; }\nth, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--edge); }\nth { color: var(--dim); font-weight: 500; }\n.grid {\n  display: grid; gap: 8px; flex: 1; min-height: 0;\n}\n.grid.n1 { grid-template-columns: 1fr; }\n.grid.n2 { grid-template-columns: 1fr 1fr; }\n.grid.n3 { grid-template-columns: 1fr 1fr 1fr; }\n.grid.n4 { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; }\n.grid.n6 { grid-template-columns: 1fr 1fr 1fr; grid-template-rows: 1fr 1fr; }\n/* Live and Export: the multiview stays inside the viewport. Each pane is 16:9\n   and its width shrinks when the cell is too short for that height. */\nbody.stage-page {\n  height: 100dvh;\n  min-height: 0;\n  overflow: hidden;\n}\nbody.stage-page main {\n  overflow: hidden;\n  min-height: 0;\n}\nbody.stage-page .grid {\n  flex: 1 1 auto;\n  align-self: stretch;\n  width: 100%;\n  min-width: 0;\n  min-height: 0;\n  max-height: 100%;\n}\nbody.stage-page .grid.n1,\nbody.stage-page .grid.n2,\nbody.stage-page .grid.n3 {\n  grid-template-rows: minmax(0, 1fr);\n}\nbody.stage-page .grid.n4,\nbody.stage-page .grid.n6 {\n  grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);\n}\nbody.stage-page .stage-rest {\n  flex: 0 1 auto;\n  min-height: 0;\n  max-height: 46%;\n  overflow: auto;\n}\n.slot {\n  min-width: 0;\n  min-height: 0;\n  width: 100%;\n  height: 100%;\n  display: grid;\n  place-items: center;\n  container-type: size;\n}\n.pane {\n  background: #000; border: 1px solid var(--edge); border-radius: 6px;\n  position: relative; overflow: hidden; min-width: 0; min-height: 0;\n}\nbody.stage-page .pane {\n  width: min(100cqw, calc(100cqh * 16 / 9));\n  height: min(100cqh, calc(100cqw * 9 / 16));\n}\n.pane video, .pane .ph {\n  position: absolute; inset: 0;\n  width: 100%; height: 100%; object-fit: contain; display: block;\n}\n.pane .ph {\n  display: flex; flex-direction: column; align-items: center; justify-content: center;\n  color: var(--dim); font-family: var(--nx-mono); font-size: 12px; gap: 6px;\n}\n.pane .tag {\n  position: absolute; top: 8px; left: 8px; z-index: 5; background: rgba(0,0,0,.65);\n  color: var(--acc); padding: 3px 8px; border-radius: 4px; font-size: 11px;\n  pointer-events: none;\n}\n.pane .pick {\n  position: absolute; top: 8px; left: 8px; z-index: 6;\n  display: flex; align-items: center; gap: 6px;\n  max-width: calc(100% - 108px);\n}\n.pane .pick select {\n  width: auto; max-width: 100%;\n  padding: 2px 6px; font-size: 11px;\n  background: rgba(0, 0, 0, .72); color: #fff; border-color: transparent;\n}\n.pane .pick .mon {\n  flex: 0 0 auto; font-size: 10px; color: var(--acc);\n  background: rgba(0, 0, 0, .72); padding: 2px 6px; border-radius: 4px;\n}\n.pane .clock {\n  position: absolute; top: 8px; right: 8px; z-index: 5; background: rgba(0,0,0,.65);\n  color: #fff; padding: 3px 8px; border-radius: 4px; font-size: 11px;\n  font-family: var(--nx-mono); pointer-events: none;\n}\n.rec-dot {\n  width: 8px; height: 8px; border-radius: 50%; background: var(--bad);\n  display: inline-block; animation: pulse 1.4s ease-in-out infinite;\n}\n@keyframes pulse { 50% { opacity: .35; } }\n.timeline {\n  height: 48px; background: var(--bg); border: 1px solid var(--edge); border-radius: 6px;\n  position: relative; cursor: pointer; margin: 8px 0;\n}\n.timeline .playhead {\n  position: absolute; top: 0; bottom: 0; width: 2px; background: var(--acc);\n}\n.timeline .mark {\n  position: absolute; top: 0; bottom: 0; width: 3px;\n}\n.timeline .mark.in { background: var(--ok); }\n.timeline .mark.out { background: var(--warn); }\n.timeline .coverage {\n  position: absolute; background: rgba(62, 207, 142, 0.28);\n  box-shadow: inset 0 -2px 0 var(--ok); pointer-events: none; z-index: 0;\n}\n.timeline .coverage.hot { background: rgba(62, 207, 142, 0.5); }\n.timeline .playhead, .timeline .mark { z-index: 2; }\n.metric-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }\n.metric-card { background: var(--bg); border: 1px solid var(--edge); border-radius: 6px; padding: 10px 12px; }\n.metric-card .val { font-size: 22px; font-variant-numeric: tabular-nums; }\n.metric-card .spark { width: 100%; height: 36px; color: var(--acc); display: block; margin-top: 6px; }\n.drive-chart {\n  width: 100%; height: 160px; margin: 8px 0 12px;\n  background: #05080c; border: 1px solid var(--edge); border-radius: 6px;\n}\n.drive-chart svg { width: 100%; height: 100%; display: block; }\n.lock-strip { display: flex; gap: 2px; align-items: center; min-height: 14px; }\n.lock-strip i { display: inline-block; width: 6px; height: 14px; background: var(--edge); }\n.lock-strip i.on { background: var(--ok); }\n.lock-strip i.off { background: var(--bad, #e35d5d); }\n.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 16px; max-width: 1100px; }\n.feat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 24px; }\n.feat-grid label { display: flex; align-items: center; gap: 8px; margin: 4px 0; }\n.thresh-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: end; }\n.thresh-row > div { min-width: 140px; }\n.lkfs-wrap { position: relative; height: 150px; background: #05080c; border-radius: 6px; border: 1px solid var(--edge); }\n.lkfs-wrap svg { width: 100%; height: 100%; display: block; }\n.pane.selected { outline: 2px solid var(--acc); outline-offset: -2px; }\n.pane.norec { box-shadow: inset 0 0 0 2px var(--warn); }\n.pane .ph.gap { color: var(--warn); text-align: center; padding: 16px; }\n.search-hits { font-size: 12px; max-height: 180px; overflow: auto; }\n.search-hits li { margin: 0 0 6px; color: var(--text); }\n.search-hits .meta { font-family: var(--nx-mono, monospace); }\n.badge {\n  display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 11px;\n  border: 1px solid var(--edge); color: var(--dim);\n}\n.badge.on { color: var(--ok); border-color: var(--ok); }\n.badge.bad { color: var(--bad); border-color: var(--bad); }\n.badge.warn { color: var(--warn); border-color: var(--warn); }\n.unit-actions button { margin: 0 4px 4px 0; padding: 4px 8px; font-size: 12px; }\n.log-pane {\n  font-family: var(--nx-mono, ui-monospace, monospace);\n  font-size: 12px; white-space: pre-wrap; max-height: 280px; overflow: auto;\n  background: #05080c; color: var(--text); padding: 10px; border-radius: 6px;\n  border: 1px solid var(--edge); margin: 0;\n}\n.setup-field { margin: 0 0 12px; max-width: 720px; }\n.setup-field textarea, .setup-field input, .setup-field select { width: 100%; }\nlabel.check { display: flex; align-items: center; gap: 8px; color: var(--text); }\nh2 { font-size: 14px; margin: 0 0 8px; color: var(--acc); }\nbutton:disabled { opacity: .45; cursor: not-allowed; }\ncode { font-family: var(--nx-mono, ui-monospace, monospace); font-size: 12px; }\n@media (max-width: 720px) {\n  .grid.n2, .grid.n3, .grid.n4, .grid.n6 { grid-template-columns: 1fr; }\n  .form-grid { grid-template-columns: 1fr; }\n  .feat-grid { grid-template-columns: 1fr; }\n  body.stage-page {\n    height: auto;\n    min-height: 100dvh;\n    overflow: visible;\n  }\n  body.stage-page main { overflow: visible; }\n  body.stage-page .grid {\n    flex: none;\n    max-height: none;\n    height: auto;\n    grid-template-rows: none;\n    grid-auto-rows: auto;\n  }\n  body.stage-page .stage-rest {\n    max-height: none;\n    overflow: visible;\n  }\n  body.stage-page .slot {\n    container-type: normal;\n    height: auto;\n    display: block;\n  }\n  body.stage-page .pane {\n    width: 100%;\n    height: auto;\n    aspect-ratio: 16 / 9;\n  }\n}\n"
