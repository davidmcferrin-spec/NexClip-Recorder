            "compression": 9538,
            "text": "<!DOCTYPE html>\n<html lang=\"en\" data-theme=\"dark\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>NexCLIP Recorder — Inputs</title>\n<link rel=\"stylesheet\" href=\"/assets/nexrec.css\">\n<script src=\"/assets/nexrec-ui.js\"></script>\n</head>\n<body>\n<nav class=\"topnav\">\n  <a class=\"brand\" href=\"/live\">NexCLIP Recorder</a>\n  <a href=\"/live\">Live</a>\n  <a href=\"/export\">Export</a>\n  <a href=\"/metrics\" data-auth-role=\"admin,operator\">Metrics</a>\n  <a class=\"active\" href=\"/inputs\" data-auth-role=\"admin,operator\">Inputs</a>\n  <a href=\"/settings\" data-auth-role=\"admin,operator\">Setup</a>\n  <a href=\"/users\" data-auth-role=\"admin\">Users</a>\n  <a href=\"/services\" data-auth-role=\"admin\">Services</a>\n  <button type=\"button\" class=\"theme-toggle\" id=\"theme-toggle\">Light</button>\n  <span class=\"nav-version\" id=\"nav-version\" hidden></span>\n  <span class=\"nav-who\" id=\"nav-who\" hidden></span>\n  <button type=\"button\" class=\"nav-logout\" id=\"nav-logout\">Log out</button>\n</nav>\n<main>\n  <div class=\"bar\">\n    <h1 style=\"margin:0\">Inputs (max 10)</h1>\n    <span class=\"ok-msg\" id=\"msg\"></span>\n  </div>\n  <div class=\"panel form-grid\" id=\"form\">\n    <div>\n      <label>ID (slug)</label><input id=\"id\" placeholder=\"studio-a\">\n      <label>Name</label><input id=\"name\" placeholder=\"Studio A\">\n      <label>Type</label>\n      <select id=\"source_type\">\n        <option value=\"rtsp\">RTSP</option>\n        <option value=\"srt\">SRT</option>\n        <option value=\"udp\">Multicast/unicast UDP</option>\n        <option value=\"tcp\">TCP</option>\n        <option value=\"rtp\">RTP</option>\n        <option value=\"decklink\">DeckLink SDI</option>\n        <option value=\"testsrc\">testsrc (demo)</option>\n      </select>\n      <div id=\"ip-fields\">\n        <label>URL</label><input id=\"url\" placeholder=\"rtsp://encoder:554/stream\">\n      </div>\n      <div id=\"decklink-fields\" style=\"display:none\">\n        <label>DeckLink sub-device</label>\n        <div class=\"bar\">\n          <select id=\"decklink_pick\"><option value=\"\">Select from this host…</option></select>\n          <button type=\"button\" id=\"decklink_refresh\">Refresh devices</button>\n        </div>\n        <input id=\"decklink_device\" placeholder=\"DeckLink Quad 2 (1)\">\n        <p class=\"sub\" id=\"decklink_hint\">FFmpeg uses the display name (Duo / Quad 2 style: <code>DeckLink Quad 2 (1)</code>). A number is the sub-device index from <code>ffmpeg -f decklink -list_devices</code>.</p>\n        <label>Format code (optional)</label>\n        <div class=\"bar\">\n          <select id=\"decklink_format_pick\"><option value=\"\">Auto-detect</option></select>\n          <button type=\"button\" id=\"decklink_formats\">List formats</button>\n        </div>\n        <input id=\"decklink_format\" placeholder=\"Hi59\">\n        <p class=\"sub\">Preview is teed inside the record process (one exclusive open). Do not start <code>nexrec-preview@</code> for this input. SDI is encoded to H.264+AAC in the locked scan: progressive stays progressive, 1080i stays interlaced. Upconvert is the only deinterlace.</p>\n      </div>\n    </div>\n    <div>\n      <label>Preview path</label><input id=\"preview_path\" placeholder=\"in0\">\n      <label>NexClip slot (1–8, Mode 2)</label><input id=\"nexclip_slot\" type=\"number\" min=\"1\" max=\"8\" placeholder=\"none\">\n      <label>Retention (days)</label><input id=\"retention_days\" type=\"number\" value=\"28\" min=\"1\" max=\"365\">\n      <label><input type=\"checkbox\" id=\"enabled\" checked> Enabled</label>\n      <label><input type=\"checkbox\" id=\"live_transcode\"> Live transcode to MP4</label>\n      <label><input type=\"checkbox\" id=\"copy_native\" checked> Copy native bitstream when possible</label>\n      <label><input type=\"checkbox\" id=\"upconvert_1080i\"> Upconvert 1080i → 1080p only</label>\n      <button type=\"button\" class=\"primary\" id=\"save\">Save input</button>\n    </div>\n  </div>\n  <div class=\"panel feat-panel\" style=\"max-width:1100px\">\n    <h1>Monitoring / intelligence (per input)</h1>\n    <p class=\"meta\">Sidecar logs and displays. Does not change the Premiere/FCPX record path. See docs/FEATURES.md.</p>\n    <div class=\"feat-grid\">\n      <label><input type=\"checkbox\" id=\"feat_scte\"> Log SCTE-35 / SCTE-104 / SCTE-224</label>\n      <label><input type=\"checkbox\" id=\"feat_av_anomaly\"> Log freeze / color bars / black (duration thresholds)</label>\n      <label><input type=\"checkbox\" id=\"feat_captions\"> Closed captions 608/708 (extract + FTS search)</label>\n      <label><input type=\"checkbox\" id=\"feat_transcribe\"> Audio transcription + diarization (off unless engine set)</label>\n      <label title=\"Logs whether a Nielsen watermark appears present or absent on the recording timeline (NTP/wall-clock timecode). Best-effort stub. Not audit-grade decode. Does not report SID, watermark time, or layer. No Nielsen Decoder SDK.\"><input type=\"checkbox\" id=\"feat_nielsen\"> Log Nielsen watermark presence (best-effort; not a decode)</label>\n      <label title=\"Marks this input for live confidence monitors. Scopes stay off until enabled on the Live page (this browser). Drawn from the WHEP preview, not the record. VU/RTA follow the stereo AAC proxy; 64-channel SDI/AES metering is not included.\"><input type=\"checkbox\" id=\"feat_monitors\"> Live confidence monitors (WFM, vectorscope, VU, 64-band RTA)</label>\n    </div>\n    <div class=\"thresh-row\">\n      <div><label>Freeze ≥ seconds</label><input id=\"thresh_freeze_s\" type=\"number\" value=\"2\" min=\"0.1\" step=\"0.1\"></div>\n      <div><label>Black ≥ seconds</label><input id=\"thresh_black_s\" type=\"number\" value=\"2\" min=\"0.1\" step=\"0.1\"></div>\n      <div><label>Color bars ≥ seconds</label><input id=\"thresh_bars_s\" type=\"number\" value=\"5\" min=\"0.1\" step=\"0.1\"></div>\n      <div><label>Transcribe engine</label>\n        <select id=\"transcribe_engine\">\n          <option value=\"\">Station default / none</option>\n          <option value=\"whisper.cpp\">whisper.cpp</option>\n          <option value=\"faster-whisper\">faster-whisper</option>\n          <option value=\"none\">none</option>\n        </select>\n      </div>\n    </div>\n  </div>\n  <div class=\"panel\" style=\"max-width:1100px\">\n    <h1>Caption / transcript search</h1>\n    <div class=\"bar\">\n      <input id=\"q\" placeholder=\"natural language…\" style=\"flex:1;min-width:160px\">\n      <button type=\"button\" id=\"search\">Search FTS</button>\n    </div>\n    <ul class=\"search-hits\" id=\"hits\"></ul>\n  </div>\n  <div class=\"panel\">\n    <table>\n      <thead><tr><th>ID</th><th>Name</th><th>Type</th><th>Preview</th><th>Slot</th><th>Retention</th><th>Intel</th><th></th></tr></thead>\n      <tbody id=\"rows\"></tbody>\n    </table>\n  </div>\n</main>\n<script src=\"/assets/nexrec-auth-gate.js\"></script>\n<script>\nNexRecAuth.requirePage({ roles: [\"admin\", \"operator\"] }).then(refresh);\nfunction val(id) { return document.getElementById(id); }\nfunction refresh() {\n  return NexRecAuth.recApi(\"inputs_list\").then(function (d) {\n    var tb = document.getElementById(\"rows\");\n    tb.innerHTML = \"\";\n    (d.inputs || []).forEach(function (r) {\n      var tr = document.createElement(\"tr\");\n      var intel = [\"scte\",\"av\",\"cc\",\"asr\",\"nielsen\",\"mon\"].filter(function (_, i) {\n        return [r.feat_scte, r.feat_av_anomaly, r.feat_captions, r.feat_transcribe, r.feat_nielsen, r.feat_monitors][i];\n      }).join(\" \") || \"—\";\n      tr.innerHTML = \"<td>\" + r.id + \"</td><td>\" + r.name + \"</td><td>\" + r.source_type +\n        \"</td><td>\" + (r.preview_path || \"\") + \"</td><td>\" + (r.nexclip_slot || \"—\") +\n        \"</td><td>\" + r.retention_days + \"d</td><td>\" + intel + \"</td><td></td>\";\n      var btn = document.createElement(\"button\");\n      btn.textContent = \"Load\";\n      btn.onclick = function () {\n        val(\"id\").value = r.id; val(\"name\").value = r.name;\n        val(\"source_type\").value = r.source_type; val(\"url\").value = r.url || \"\";\n        val(\"decklink_device\").value = r.decklink_device || \"\";\n        val(\"decklink_format\").value = r.decklink_format || \"\";\n        syncType();\n        val(\"preview_path\").value = r.preview_path || \"\";\n        val(\"nexclip_slot\").value = r.nexclip_slot || \"\";\n        val(\"retention_days\").value = r.retention_days;\n        val(\"enabled\").checked = !!r.enabled;\n        val(\"live_transcode\").checked = !!r.live_transcode;\n        val(\"copy_native\").checked = !!r.copy_native;\n        val(\"upconvert_1080i\").checked = !!r.upconvert_1080i;\n        val(\"feat_scte\").checked = !!r.feat_scte;\n        val(\"feat_av_anomaly\").checked = !!r.feat_av_anomaly;\n        val(\"feat_captions\").checked = !!r.feat_captions;\n        val(\"feat_transcribe\").checked = !!r.feat_transcribe;\n        val(\"feat_nielsen\").checked = !!r.feat_nielsen;\n        val(\"feat_monitors\").checked = !!r.feat_monitors;\n        val(\"thresh_freeze_s\").value = r.thresh_freeze_s || 2;\n        val(\"thresh_black_s\").value = r.thresh_black_s || 2;\n        val(\"thresh_bars_s\").value = r.thresh_bars_s || 5;\n        val(\"transcribe_engine\").value = r.transcribe_engine || \"\";\n      };\n      tr.lastChild.appendChild(btn);\n      tb.appendChild(tr);\n    });\n  });\n}\nval(\"save\").onclick = function () {\n  NexRecAuth.recApi(\"input_put\", {\n    id: val(\"id\").value, name: val(\"name\").value, source_type: val(\"source_type\").value,\n    url: val(\"url\").value, decklink_device: val(\"decklink_device\").value,\n    decklink_format: val(\"decklink_format\").value,\n    keep_interlace: 0,\n    preview_path: val(\"preview_path\").value, nexclip_slot: Number(val(\"nexclip_slot\").value) || null,\n    retention_days: Number(val(\"retention_days\").value),\n    enabled: val(\"enabled\").checked, live_transcode: val(\"live_transcode\").checked,\n    copy_native: val(\"copy_native\").checked, upconvert_1080i: val(\"upconvert_1080i\").checked,\n    feat_scte: val(\"feat_scte\").checked, feat_av_anomaly: val(\"feat_av_anomaly\").checked,\n    feat_captions: val(\"feat_captions\").checked, feat_transcribe: val(\"feat_transcribe\").checked,\n    feat_nielsen: val(\"feat_nielsen\").checked, feat_monitors: val(\"feat_monitors\").checked,\n    thresh_freeze_s: Number(val(\"thresh_freeze_s\").value),\n    thresh_black_s: Number(val(\"thresh_black_s\").value),\n    thresh_bars_s: Number(val(\"thresh_bars_s\").value),\n    transcribe_engine: val(\"transcribe_engine\").value,\n  }).then(function () { document.getElementById(\"msg\").textContent = \"saved\"; return refresh(); })\n    .catch(function (e) { document.getElementById(\"msg\").textContent = e.message; });\n};\nval(\"search\").onclick = function () {\n  var q = val(\"q\").value;\n  NexRecAuth.recApi(\"search_text\", { q: q, input_id: val(\"id\").value || undefined }).then(function (d) {\n    var ul = document.getElementById(\"hits\");\n    ul.innerHTML = \"\";\n    (d.hits || []).forEach(function (h) {\n      var li = document.createElement(\"li\");\n      var when = h.t_start ? NexRecUI.formatStation(h.t_start, true) : \"\";\n      li.innerHTML = \"<span class=\\\"meta\\\">\" + when + \" \" + (h.kind || \"\") +\n        (h.speaker ? \" \" + h.speaker : \"\") + \"</span> \" + (h.text || \"\");\n      ul.appendChild(li);\n    });\n    if (!(d.hits || []).length) {\n      ul.innerHTML = \"<li class=\\\"meta\\\">no hits (\" + (d.engine || \"\") + \")</li>\";\n    }\n  }).catch(function (e) { document.getElementById(\"msg\").textContent = e.message; });\n};\nfunction syncType() {\n  var deck = val(\"source_type\").value === \"decklink\";\n  document.getElementById(\"ip-fields\").style.display = deck ? \"none\" : \"\";\n  document.getElementById(\"decklink-fields\").style.display = deck ? \"\" : \"none\";\n}\nval(\"source_type\").onchange = syncType;\nsyncType();\nval(\"decklink_pick\").onchange = function () {\n  if (val(\"decklink_pick\").value) val(\"decklink_device\").value = val(\"decklink_pick\").value;\n};\nval(\"decklink_format_pick\").onchange = function () {\n  val(\"decklink_format\").value = val(\"decklink_format_pick\").value;\n};\nval(\"decklink_refresh\").onclick = function () {\n  var hint = document.getElementById(\"decklink_hint\");\n  hint.textContent = \"listing DeckLink devices…\";\n  NexRecAuth.recApi(\"decklink_devices\").then(function (d) {\n    var sel = val(\"decklink_pick\");\n    sel.innerHTML = '<option value=\"\">Select from this host…</option>';\n    (d.devices || []).forEach(function (dev) {\n      var opt = document.createElement(\"option\");\n      opt.value = dev.name;\n      opt.textContent = dev.index + \" — \" + dev.name;\n      sel.appendChild(opt);\n    });\n    if (!d.decklink_enabled) {\n      hint.textContent = d.message || \"ffmpeg is not built with DeckLink\";\n    } else if (!(d.devices || []).length) {\n      hint.textContent = d.message || \"no sub-devices listed\";\n    } else {\n      hint.textContent = (d.devices.length) + \" sub-device(s). Names look like DeckLink Quad 2 (1) or DeckLink Duo (1).\";\n    }\n  }).catch(function (e) { hint.textContent = e.message; });\n};\nval(\"decklink_formats\").onclick = function () {\n  var hint = document.getElementById(\"decklink_hint\");\n  var device = val(\"decklink_device\").value;\n  if (!device || /^[0-9]{1,2}$/.test(device)) {\n    hint.textContent = \"pick a display name before listing formats\";\n    return;\n  }\n  NexRecAuth.recApi(\"decklink_formats\", { device: device }).then(function (d) {\n    var sel = val(\"decklink_format_pick\");\n    sel.innerHTML = '<option value=\"\">Auto-detect</option>';\n    (d.formats || []).forEach(function (code) {\n      var opt = document.createElement(\"option\");\n      opt.value = code;\n      opt.textContent = code;\n      sel.appendChild(opt);\n    });\n    hint.textContent = d.message || ((d.formats || []).length ? \"format codes loaded\" : \"no format codes reported\");\n  }).catch(function (e) { hint.textContent = e.message; });\n};\n</script>\n</body>\n</html>\n"
          },
