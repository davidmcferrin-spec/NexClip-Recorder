          "content": {
            "size": 2648,
            "mimeType": "text/html",
            "compression": 1590,
            "text": "<!DOCTYPE html>\n<html lang=\"en\" data-theme=\"dark\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>NexCLIP Recorder — Users</title>\n<link rel=\"stylesheet\" href=\"/assets/nexrec.css\">\n<script src=\"/assets/nexrec-ui.js\"></script>\n</head>\n<body>\n<nav class=\"topnav\">\n  <a class=\"brand\" href=\"/live\">NexCLIP Recorder</a>\n  <a href=\"/live\">Live</a>\n  <a href=\"/export\">Export</a>\n  <a href=\"/metrics\" data-auth-role=\"admin,operator\">Metrics</a>\n  <a href=\"/inputs\" data-auth-role=\"admin,operator\">Inputs</a>\n  <a href=\"/settings\" data-auth-role=\"admin,operator\">Setup</a>\n  <a class=\"active\" href=\"/users\" data-auth-role=\"admin\">Users</a>\n  <a href=\"/services\" data-auth-role=\"admin\">Services</a>\n  <button type=\"button\" class=\"theme-toggle\" id=\"theme-toggle\">Light</button>\n  <span class=\"nav-version\" id=\"nav-version\" hidden></span>\n  <span class=\"nav-who\" id=\"nav-who\" hidden></span>\n  <button type=\"button\" class=\"nav-logout\" id=\"nav-logout\">Log out</button>\n</nav>\n<main>\n  <div class=\"panel form-grid\">\n    <div>\n      <label>Username</label><input id=\"username\">\n      <label>Password</label><input id=\"password\" type=\"password\">\n    </div>\n    <div>\n      <label>Role</label>\n      <select id=\"role\"><option>admin</option><option>operator</option><option>viewer</option></select>\n      <label>Email</label><input id=\"email\">\n      <button type=\"button\" class=\"primary\" id=\"create\">Create local user</button>\n      <p class=\"sub\">LDAP is optional and recorder-local only. NexAPP SSO users appear after first successful sign-in.</p>\n    </div>\n  </div>\n  <div class=\"panel\">\n    <table><thead><tr><th>User</th><th>Role</th><th>Source</th></tr></thead><tbody id=\"rows\"></tbody></table>\n  </div>\n</main>\n<script src=\"/assets/nexrec-auth-gate.js\"></script>\n<script>\nfunction refresh() {\n  return NexRecAuth.api(\"users_list\").then(function (d) {\n    var tb = document.getElementById(\"rows\");\n    tb.innerHTML = \"\";\n    (d.users || []).forEach(function (u) {\n      var tr = document.createElement(\"tr\");\n      tr.innerHTML = \"<td>\" + u.username + \"</td><td>\" + u.role + \"</td><td>\" + u.source + \"</td>\";\n      tb.appendChild(tr);\n    });\n  });\n}\nNexRecAuth.requirePage({ roles: [\"admin\"] }).then(refresh);\ndocument.getElementById(\"create\").onclick = function () {\n  NexRecAuth.api(\"user_create\", {\n    username: document.getElementById(\"username\").value,\n    password: document.getElementById(\"password\").value,\n    role: document.getElementById(\"role\").value,\n    email: document.getElementById(\"email\").value,\n    must_change_password: true,\n  }).then(refresh);\n};\n</script>\n</body>\n</html>\n"
          },
