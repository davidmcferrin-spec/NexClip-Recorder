            "text": "@import url(\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap\");\n\n/* Fallback copy of NexAPP /assets/nexapp-theme.css tokens (from NexVUE portal). */\n\n:root,\n[data-theme=\"light\"] {\n  color-scheme: light;\n  --nx-bg: #f3f4f6;\n  --nx-surface: #ffffff;\n  --nx-surface-2: #f9fafb;\n  --nx-ink: #111827;\n  --nx-muted: #6b7280;\n  --nx-line: #e5e7eb;\n  --nx-accent: #2563eb;\n  --nx-accent-hover: #1d4ed8;\n  --nx-accent-soft: #eff6ff;\n  --nx-ok: #067647;\n  --nx-warn: #b54708;\n  --nx-danger: #b42318;\n  --nx-hero-from: #0b3a5c;\n  --nx-hero-to: #1a6b9a;\n  --nx-tile-shadow: 0 1px 2px rgba(17, 24, 39, 0.06), 0 4px 12px rgba(17, 24, 39, 0.04);\n  --nx-font: \"IBM Plex Sans\", \"Segoe UI\", \"Helvetica Neue\", sans-serif;\n  --nx-mono: \"IBM Plex Mono\", ui-monospace, Consolas, monospace;\n  --nx-radius: 10px;\n  --nx-sidebar: #ffffff;\n  --nx-sidebar-border: #e5e7eb;\n  --nx-rail-active: #2563eb;\n}\n\n[data-theme=\"dark\"] {\n  color-scheme: dark;\n  --nx-bg: #0b0f14;\n  --nx-surface: #151b23;\n  --nx-surface-2: #1a222c;\n  --nx-ink: #e8eef4;\n  --nx-muted: #9aa8b5;\n  --nx-line: #2a3542;\n  --nx-accent: #3ecf8e;\n  --nx-accent-hover: #2fb87a;\n  --nx-accent-soft: rgba(62, 207, 142, 0.12);\n  --nx-ok: #3ecf8e;\n  --nx-warn: #f5a524;\n  --nx-danger: #f87171;\n  --nx-hero-from: #061018;\n  --nx-hero-to: #0d2838;\n  --nx-tile-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);\n  --nx-sidebar: #0f1419;\n  --nx-sidebar-border: #1e2834;\n  --nx-rail-active: #3ecf8e;\n}\n"
