            "mimeType": "application/json",
            "compression": 0,
            "text": "{\"ok\":true,\"warn\":true,\"cuts_retention\":true,\"message\":\"Drive is 86.4% full. Purge starts at 98% used (warning begins 5 points sooner). Free space is at the 50.0 GiB floor. About under 0.1 days of recording are left for all inputs together. That is before the retention on in1 (1 days). The next cleanup pass deletes the oldest video.\",\"used_bytes\":90792382464,\"free_bytes\":14296879104,\"total_bytes\":105089261568,\"used_pct\":86.4,\"usable_bytes\":0,\"max_used_percent\":98,\"warn_points\":5,\"floor_bytes\":53687091200,\"system_days\":0,\"system_rate_bps\":1405795.8767413623,\"inputs\":[{\"id\":\"in1\",\"name\":\"in1\",\"enabled\":true,\"retention_days\":1,\"stored_bytes\":63675524237,\"rate_bps\":1405795.8767413623,\"rate_source\":\"measured\",\"days_on_disk\":0.5242476851851852,\"days_left\":0}]}"
