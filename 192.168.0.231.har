          "cookies": [],
          "content": {
            "size": 7977,
            "mimeType": "text/html",
            "compression": 5123,
            "text": "<!DOCTYPE html>\n<html lang=\"en\" data-theme=\"dark\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>NexCLIP Recorder — Services</title>\n<link rel=\"stylesheet\" href=\"/assets/nexrec.css\">\n<script src=\"/assets/nexrec-ui.js\"></script>\n</head>\n<body>\n<nav class=\"topnav\">\n  <a class=\"brand\" href=\"/live\">NexCLIP Recorder</a>\n  <a href=\"/live\">Live</a>\n  <a href=\"/export\">Export</a>\n  <a href=\"/metrics\" data-auth-role=\"admin,operator\">Metrics</a>\n  <a href=\"/inputs\" data-auth-role=\"admin,operator\">Inputs</a>\n  <a href=\"/settings\" data-auth-role=\"admin,operator\">Setup</a>\n  <a href=\"/users\" data-auth-role=\"admin\">Users</a>\n  <a class=\"active\" href=\"/services\" data-auth-role=\"admin\">Services</a>\n  <button type=\"button\" class=\"theme-toggle\" id=\"theme-toggle\">Light</button>\n  <span class=\"nav-version\" id=\"nav-version\" hidden></span>\n  <span class=\"nav-who\" id=\"nav-who\" hidden></span>\n  <button type=\"button\" class=\"nav-logout\" id=\"nav-logout\">Log out</button>\n</nav>\n<main>\n  <div class=\"bar\">\n    <h1 style=\"margin:0\">Services</h1>\n    <button type=\"button\" id=\"refresh\">Refresh</button>\n    <span class=\"sub\" id=\"hint\"></span>\n  </div>\n  <div class=\"panel\">\n    <h2>systemd units</h2>\n    <p class=\"sub\">Active, enabled, and uptime come from <code>systemctl show</code>. Start, stop, restart, enable, and disable go through <code>bin/nexrec-systemctl.sh</code> (sudoers allowlist). Hosts without systemd show unknown.</p>\n    <table>\n      <thead>\n        <tr><th>Unit</th><th>Active</th><th>Enabled</th><th>Since</th><th>Uptime</th><th></th></tr>\n      </thead>\n      <tbody id=\"units\"></tbody>\n    </table>\n  </div>\n  <div class=\"panel\">\n    <h2>Journal</h2>\n    <p class=\"sub\" id=\"log-title\">Select a unit to load the last 80 journal lines.</p>\n    <pre class=\"log-pane\" id=\"log\">—</pre>\n  </div>\n  <div class=\"panel\">\n    <h2>Signal</h2>\n    <p class=\"sub\">SDI lock comes from <code>nexrec-decklink-status</code> (<code>NEXREC_DECKLINK_STATUS_BIN</code> or Setup). The helper prints JSON per sub-device (<code>input_locked</code>, <code>input_mode</code>, <code>busy</code>). A busy connector — the recorder already has it open — still reports lock and format. Without the helper the row stays unknown and keeps the last format the record worker stored. DeckLink preview units are skipped; the proxy is teed inside <code>nexrec-record</code>. IP rows use the worker heartbeat and last chunk time.</p>\n    <table>\n      <thead>\n        <tr><th>Input</th><th>Type</th><th>Signal</th><th>SDI lock</th><th>Format</th><th>Last chunk</th><th>Last seen</th><th>Detail</th></tr>\n      </thead>\n      <tbody id=\"signals\"></tbody>\n    </table>\n  </div>\n</main>\n<script src=\"/assets/nexrec-auth-gate.js\"></script>\n<script>\nNexRecAuth.requirePage({ roles: [\"admin\"] }).then(refresh);\n\nfunction esc(s) {\n  return String(s == null ? \"\" : s).replace(/[&<>\"']/g, function (c) {\n    return { \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c];\n  });\n}\nfunction badge(state) {\n  var cls = \"off\";\n  if (state === \"active\" || state === \"enabled\" || state === \"present\" || state === \"receiving\") cls = \"on\";\n  else if (state === \"failed\" || state === \"down\" || state === \"no_signal\") cls = \"bad\";\n  else if (state === \"stalled\" || state === \"activating\" || state === \"deactivating\" || state === \"skipped\") cls = \"warn\";\n  return '<span class=\"badge ' + cls + '\">' + esc(state || \"unknown\") + \"</span>\";\n}\nfunction uptime(sec) {\n  if (sec == null || sec === \"\") return \"—\";\n  sec = Number(sec);\n  if (!isFinite(sec)) return \"—\";\n  var h = Math.floor(sec / 3600);\n  var m = Math.floor((sec % 3600) / 60);\n  var s = Math.floor(sec % 60);\n  if (h > 0) return h + \"h \" + m + \"m\";\n  if (m > 0) return m + \"m \" + s + \"s\";\n  return s + \"s\";\n}\nfunction ops(action, body, query) {\n  var url = \"/api/ops?action=\" + encodeURIComponent(action);\n  if (query) {\n    Object.keys(query).forEach(function (k) {\n      url += \"&\" + encodeURIComponent(k) + \"=\" + encodeURIComponent(query[k]);\n    });\n  }\n  var opts = { credentials: \"same-origin\", cache: \"no-store\", headers: {} };\n  if (body) {\n    opts.method = \"POST\";\n    opts.headers[\"Content-Type\"] = \"application/json\";\n    opts.body = JSON.stringify(body);\n  }\n  return fetch(url, opts).then(function (res) {\n    return res.json().then(function (data) {\n      if (!data) throw new Error(\"empty\");\n      return data;\n    });\n  });\n}\nfunction loadLog(unit) {\n  document.getElementById(\"log-title\").textContent = unit + \" — journalctl -n 80\";\n  document.getElementById(\"log\").textContent = \"loading…\";\n  ops(\"journal\", null, { unit: unit, n: 80 }).then(function (d) {\n    var lines = d.lines || [];\n    document.getElementById(\"log\").textContent = lines.length ? lines.join(\"\\n\") : (d.error || \"(no journal lines)\");\n  }).catch(function (e) {\n    document.getElementById(\"log\").textContent = String(e.message || e);\n  });\n}\nfunction refresh() {\n  document.getElementById(\"hint\").textContent = \"loading…\";\n  return Promise.all([ops(\"units\"), ops(\"signals\")]).then(function (all) {\n    var units = all[0].units || [];\n    var can = !!all[0].can_control;\n    var tb = document.getElementById(\"units\");\n    tb.innerHTML = \"\";\n    units.forEach(function (u) {\n      var tr = document.createElement(\"tr\");\n      var actions = '<button type=\"button\" data-act=\"log\">Log</button>';\n      var verbs = u.skipped ? [\"stop\", \"disable\"] : [\"start\", \"stop\", \"restart\", \"enable\", \"disable\"];\n      if (can) {\n        verbs.forEach(function (v) {\n          actions += ' <button type=\"button\" data-act=\"' + v + '\">' + v + \"</button>\";\n        });\n      }\n      var note = u.note ? '<div class=\"sub\">' + esc(u.note) + \"</div>\" : \"\";\n      tr.innerHTML = \"<td><code>\" + esc(u.unit) + \"</code>\" + note + \"</td><td>\" + badge(u.active) +\n        \"</td><td>\" + badge(u.enabled) + \"</td><td>\" + esc(u.active_enter || \"—\") +\n        \"</td><td>\" + esc(uptime(u.uptime_s)) + '</td><td class=\"unit-actions\">' + actions + \"</td>\";\n      tr.querySelectorAll(\"button\").forEach(function (btn) {\n        btn.onclick = function () {\n          var act = btn.getAttribute(\"data-act\");\n          if (act === \"log\") { loadLog(u.unit); return; }\n          btn.disabled = true;\n          ops(\"control\", { verb: act, unit: u.unit }).then(function (d) {\n            document.getElementById(\"hint\").textContent = d.ok ? (act + \" \" + u.unit) : (d.error || \"control failed\");\n            refresh();\n          }).catch(function (e) {\n            document.getElementById(\"hint\").textContent = String(e.message || e);\n            btn.disabled = false;\n          });\n        };\n      });\n      tb.appendChild(tr);\n    });\n    if (!units.length) {\n      tb.innerHTML = '<tr><td colspan=\"6\" class=\"empty\">No units.</td></tr>';\n    }\n    var sb = document.getElementById(\"signals\");\n    sb.innerHTML = \"\";\n    (all[1].signals || []).forEach(function (s) {\n      var lock = s.sdi_lock == null ? \"—\" : (Number(s.sdi_lock) ? \"locked\" : \"unlocked\");\n      if (s.busy) lock += \" (in use)\";\n      var tr = document.createElement(\"tr\");\n      tr.innerHTML = \"<td>\" + esc(s.name || s.input_id) + \"</td><td>\" + esc(s.source_type) +\n        \"</td><td>\" + badge(s.signal) + \"</td><td>\" + esc(lock) + \"</td><td>\" + esc(s.format || \"—\") +\n        \"</td><td>\" + esc(s.last_chunk_at ? NexRecUI.formatStation(s.last_chunk_at, true) : \"—\") + \"</td><td>\" + esc(s.seen_at ? NexRecUI.formatStation(s.seen_at, true) : \"—\") +\n        \"</td><td class='sub'>\" + esc(s.detail || \"\") + \"</td>\";\n      sb.appendChild(tr);\n    });\n    if (!(all[1].signals || []).length) {\n      sb.innerHTML = '<tr><td colspan=\"8\" class=\"empty\">No inputs configured.</td></tr>';\n    }\n    document.getElementById(\"hint\").textContent = can ? \"\" : \"read only\";\n  }).catch(function (e) {\n    document.getElementById(\"hint\").textContent = String(e.message || e);\n  });\n}\ndocument.getElementById(\"refresh\").onclick = refresh;\n</script>\n</body>\n</html>\n"
          },
          "redirectURL": "",
          "headersSize": 368,
          "bodySize": 2854,
          "_transferSize": 3222,
