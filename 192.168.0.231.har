            "mimeType": "text/html",
            "compression": 19175,
            "text": "<!DOCTYPE html>\n<html lang=\"en\" data-theme=\"dark\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>NexCLIP Recorder — Export</title>\n<link rel=\"stylesheet\" href=\"/assets/nexrec.css\">\n<script src=\"/assets/nexrec-ui.js\"></script>\n</head>\n<body class=\"stage-page\">\n<nav class=\"topnav\">\n  <a class=\"brand\" href=\"/live\">NexCLIP Recorder</a>\n  <a href=\"/live\">Live</a>\n  <a class=\"active\" href=\"/export\">Export</a>\n  <a href=\"/metrics\" data-auth-role=\"admin,operator\">Metrics</a>\n  <a href=\"/inputs\" data-auth-role=\"admin,operator\">Inputs</a>\n  <a href=\"/settings\" data-auth-role=\"admin,operator\">Setup</a>\n  <a href=\"/users\" data-auth-role=\"admin\">Users</a>\n  <a href=\"/services\" data-auth-role=\"admin\">Services</a>\n  <button type=\"button\" class=\"theme-toggle\" id=\"theme-toggle\">Light</button>\n  <span class=\"nav-version\" id=\"nav-version\" hidden></span>\n  <span class=\"nav-who\" id=\"nav-who\" hidden></span>\n  <button type=\"button\" class=\"nav-logout\" id=\"nav-logout\">Log out</button>\n</nav>\n<main>\n  <div class=\"bar\">\n    <span class=\"meta\">Layout</span>\n    <div class=\"seg\" id=\"layout-seg\">\n      <button type=\"button\" data-n=\"1\" class=\"active\">1</button>\n      <button type=\"button\" data-n=\"2\">2</button>\n      <button type=\"button\" data-n=\"3\">3</button>\n      <button type=\"button\" data-n=\"4\">4</button>\n      <button type=\"button\" data-n=\"6\">6</button>\n    </div>\n    <button type=\"button\" id=\"mark-in\">Mark I</button>\n    <button type=\"button\" id=\"mark-out\">Mark O</button>\n    <span class=\"meta\" id=\"io\">I — / O —</span>\n    <label class=\"meta\" style=\"margin:0\">Scope\n      <select id=\"scope\"><option value=\"one\">This stream</option><option value=\"all\">All visible</option></select>\n    </label>\n    <label class=\"meta\" style=\"margin:0\">Quality\n      <select id=\"quality\"><option value=\"full\">Full (native)</option><option value=\"proxy\">Proxy</option></select>\n    </label>\n    <button type=\"button\" class=\"primary\" id=\"do-export\">Export trim</button>\n    <span class=\"ok-msg\" id=\"msg\"></span>\n  </div>\n  <div class=\"grid n1\" id=\"grid\"></div>\n  <div class=\"stage-rest\">\n  <div class=\"bar\" id=\"range-bar\">\n    <span class=\"meta\">Range</span>\n    <input type=\"text\" class=\"range-time\" id=\"range-start\" spellcheck=\"false\" autocomplete=\"off\" placeholder=\"YYYY-MM-DD HH:MM:SS\" aria-label=\"Timeline start, station time\">\n    <span class=\"meta\">to</span>\n    <input type=\"text\" class=\"range-time\" id=\"range-end\" spellcheck=\"false\" autocomplete=\"off\" placeholder=\"YYYY-MM-DD HH:MM:SS\" aria-label=\"Timeline end, station time\">\n    <button type=\"button\" id=\"range-apply\">Apply</button>\n    <button type=\"button\" id=\"range-hour\">Last hour</button>\n    <button type=\"button\" id=\"range-all\">All loaded</button>\n  </div>\n  <div class=\"timeline\" id=\"timeline\" title=\"Scrub the selected station-time range. Shaded spans have a recording.\">\n    <div class=\"playhead\" id=\"playhead\"></div>\n    <div class=\"mark in\" id=\"mark-in-el\" hidden></div>\n    <div class=\"mark out\" id=\"mark-out-el\" hidden></div>\n  </div>\n  <div class=\"timeline-scale\">\n    <span id=\"scale-start\">—</span>\n    <span id=\"scale-end\">—</span>\n  </div>\n  <p class=\"sub\" id=\"coverage-note\">Shaded spans have a recording inside this range. Empty stretches do not.</p>\n  <div class=\"bar\">\n    <button type=\"button\" id=\"play-toggle\" aria-pressed=\"false\" title=\"Play the selected pane. Other panes stay muted.\">Play</button>\n    <span class=\"meta\">Volume</span>\n    <input type=\"range\" id=\"listen-vol\" class=\"listen-vol\" min=\"0\" max=\"1\" step=\"0.05\" value=\"0.8\" aria-label=\"Volume for the selected pane\">\n    <input type=\"range\" id=\"scrub\" min=\"0\" max=\"1000\" value=\"0\" style=\"flex:1\">\n    <span class=\"meta\" id=\"tlabel\" style=\"font-family:var(--nx-mono)\">—</span>\n  </div>\n  <div class=\"panel\" id=\"lkfs-panel\">\n    <h1>CALM Act · LKFS</h1>\n    <p class=\"meta\">Export editor only. ITU-R BS.1770 / ATSC A/85 target <strong>−24 LKFS</strong>. FFmpeg <code>ebur128</code> on the selected I/O (not live multiviewer).</p>\n    <div class=\"bar\">\n      <button type=\"button\" id=\"measure-lkfs\">Measure selected range</button>\n      <span class=\"meta\" id=\"lkfs-msg\">Mark I/O, then measure. Enqueues sidecar job — PHP does not shell FFmpeg.</span>\n    </div>\n    <div class=\"lkfs-wrap\" id=\"lkfs-wrap\">\n      <svg viewBox=\"0 0 1000 150\" preserveAspectRatio=\"none\" aria-label=\"LKFS chart\">\n        <line x1=\"0\" y1=\"75\" x2=\"1000\" y2=\"75\" stroke=\"#f5a524\" stroke-dasharray=\"6 4\" stroke-width=\"1\"/>\n        <text x=\"8\" y=\"20\" fill=\"#9aa8b5\" font-size=\"12\">−10</text>\n        <text x=\"8\" y=\"79\" fill=\"#f5a524\" font-size=\"12\">−24 LKFS</text>\n        <text x=\"8\" y=\"142\" fill=\"#9aa8b5\" font-size=\"12\">−40</text>\n        <polyline id=\"lkfs-line\" fill=\"none\" stroke=\"#3ecf8e\" stroke-width=\"2\" points=\"\"/>\n      </svg>\n    </div>\n  </div>\n  <div class=\"panel\" id=\"jobs-panel\">\n    <h1>Queue</h1>\n    <p class=\"sub\">The export service works this list one job at a time. ETA uses the trim length and FFmpeg’s progress. Cancel stops a queued job immediately and asks a running job to stop.</p>\n    <table>\n      <thead><tr><th>Job</th><th>Window</th><th>Inputs</th><th>Quality</th><th>Status</th><th>ETA</th><th></th></tr></thead>\n      <tbody id=\"jobs\"></tbody>\n    </table>\n  </div>\n  </div>\n</main>\n<script src=\"/assets/nexrec-auth-gate.js\"></script>\n<script>\n(function () {\n  var n = 1, inputs = [], chunksByInput = {}, t0 = 0, t1 = 0, archive0 = 0, archive1 = 0, play = 0, markIn = null, markOut = null;\n  var selected = 0, playing = false, slotIds = null, scrolledJob = \"\";\n  var SLOT_KEY = \"nexrec-export-slots\";\n  var VOL_KEY = \"nexrec-export-volume\";\n  var volume = 0.8;\n  try {\n    var rawVol = localStorage.getItem(VOL_KEY);\n    if (rawVol != null && rawVol !== \"\") {\n      var stored = Number(rawVol);\n      if (Number.isFinite(stored)) volume = Math.max(0, Math.min(1, stored));\n    }\n  } catch (e) {}\n\n  NexRecAuth.requirePage().then(function () {\n    return Promise.all([\n      NexRecAuth.recApi(\"inputs_list\"),\n      NexRecAuth.recApi(\"chunks_list\"),\n      NexRecAuth.recApi(\"exports_list\"),\n    ]);\n  }).then(function (all) {\n    inputs = all[0].inputs || [];\n    if (slotIds == null) slotIds = NexRecUI.readPaneSlots(localStorage, SLOT_KEY);\n    (all[1].chunks || []).forEach(function (c) {\n      (chunksByInput[c.input_id] = chunksByInput[c.input_id] || []).push(c);\n    });\n    var allc = all[1].chunks || [];\n    if (allc.length) {\n      t0 = Date.parse(allc[allc.length - 1].start_at);\n      t1 = Date.parse(allc[0].end_at || allc[0].start_at);\n      if (!isFinite(t0) || !isFinite(t1) || t1 <= t0) { t0 = Date.now() - 3600000; t1 = Date.now(); }\n    } else {\n      t1 = Date.now(); t0 = t1 - 3600000;\n    }\n    archive0 = t0;\n    archive1 = t1;\n    play = t0;\n    fillRangeFields();\n    var vol = document.getElementById(\"listen-vol\");\n    if (vol) vol.value = String(volume);\n    paintJobs(all[2].exports || []);\n    render();\n    tick();\n  });\n\n  function iso(ms) { return new Date(ms).toISOString().replace(\".000\", \"\"); }\n  function esc(s) {\n    return String(s == null ? \"\" : s).replace(/[&<>\"']/g, function (c) {\n      return { \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c];\n    });\n  }\n\n  function chunkHit(iid, ms) {\n    var list = chunksByInput[iid] || [];\n    for (var i = 0; i < list.length; i++) {\n      var c = list[i];\n      var a = Date.parse(c.start_at);\n      var b = Date.parse(c.end_at || c.start_at);\n      if (a <= ms && b > ms) return c;\n    }\n    return null;\n  }\n\n  function selectedVideo() {\n    var pane = document.querySelector('#grid .pane[data-slot=\"' + selected + '\"]');\n    return pane ? pane.querySelector(\"video\") : null;\n  }\n\n  function visibleIds() {\n    return NexRecUI.paneSlotIds(inputs, slotIds);\n  }\n\n  function selectedInput() {\n    var id = visibleIds()[selected] || \"\";\n    if (!id) return null;\n    for (var i = 0; i < inputs.length; i++) {\n      if (String(inputs[i].id) === id) return inputs[i];\n    }\n    return null;\n  }\n\n  function choosePane(i) {\n    if (selected === i) return;\n    selected = i;\n    document.querySelectorAll(\"#grid .pane\").forEach(function (p, idx) {\n      p.classList.toggle(\"selected\", idx === selected);\n    });\n    syncMedia(false);\n  }\n\n  function assignPane(i, inputId) {\n    slotIds = NexRecUI.paneAssign(visibleIds(), i, inputId);\n    NexRecUI.writePaneSlots(localStorage, SLOT_KEY, slotIds);\n    selected = i;\n    render();\n    var one = selectedInput();\n    if (playing && (!one || !chunkHit(one.id, play))) stopPlayback();\n    tick();\n  }\n\n  function paintPlayButton() {\n    var btn = document.getElementById(\"play-toggle\");\n    if (!btn) return;\n    btn.textContent = playing ? \"Pause\" : \"Play\";\n    btn.classList.toggle(\"tgl\", playing);\n    btn.classList.toggle(\"active\", playing);\n    btn.setAttribute(\"aria-pressed\", playing ? \"true\" : \"false\");\n  }\n\n  function stopPlayback() {\n    playing = false;\n    paintPlayButton();\n    document.querySelectorAll(\"#grid .pane video\").forEach(function (v) {\n      v.muted = true;\n      if (!v.paused) v.pause();\n    });\n  }\n\n  function station(ms) {\n    return NexRecUI.formatStation(ms, true);\n  }\n\n  function fillRangeFields() {\n    document.getElementById(\"range-start\").value = NexRecUI.stationStamp(t0);\n    document.getElementById(\"range-end\").value = NexRecUI.stationStamp(t1);\n  }\n\n  function placeMark(id, ms) {\n    var el = document.getElementById(id);\n    if (ms == null || ms < t0 || ms > t1) {\n      el.hidden = true;\n      return;\n    }\n    el.hidden = false;\n    el.style.left = ((ms - t0) / Math.max(1, t1 - t0) * 100) + \"%\";\n  }\n\n  function paintChrome() {\n    document.getElementById(\"tlabel\").textContent = station(play);\n    document.getElementById(\"scale-start\").textContent = station(t0);\n    document.getElementById(\"scale-end\").textContent = station(t1);\n    var pct = (play - t0) / Math.max(1, t1 - t0);\n    document.getElementById(\"playhead\").style.left = (pct * 100) + \"%\";\n    document.getElementById(\"scrub\").value = String(Math.round(pct * 1000));\n    document.getElementById(\"io\").textContent =\n      \"I \" + (markIn ? station(markIn) : \"—\") + \" / O \" + (markOut ? station(markOut) : \"—\");\n    placeMark(\"mark-in-el\", markIn);\n    placeMark(\"mark-out-el\", markOut);\n    document.getElementById(\"coverage-note\").textContent =\n      \"Scrubbing \" + station(t0) + \" → \" + station(t1) +\n      \". Shaded spans have a recording in this range. Loaded archive is \" +\n      station(archive0) + \" → \" + station(archive1) + \" (newest 500 chunks).\";\n    paintCoverage();\n  }\n\n  function paintCoverage() {\n    var bar = document.getElementById(\"timeline\");\n    bar.querySelectorAll(\".coverage\").forEach(function (el) { el.remove(); });\n    var lanes = NexRecUI.paneInputs(inputs, visibleIds(), n).filter(Boolean);\n    var laneH = lanes.length ? (100 / lanes.length) : 100;\n    bar.style.height = Math.max(48, lanes.length * 18) + \"px\";\n    lanes.forEach(function (inp, lane) {\n      var hot = selectedInput() && inp.id === selectedInput().id;\n      NexRecUI.coverageSpans(chunksByInput[inp.id] || [], t0, t1).forEach(function (sp) {\n        var el = document.createElement(\"div\");\n        el.className = hot ? \"coverage hot\" : \"coverage\";\n        el.style.left = sp.left + \"%\";\n        el.style.width = Math.max(sp.width, 0.15) + \"%\";\n        el.style.top = (lane * laneH) + \"%\";\n        el.style.height = laneH + \"%\";\n        el.title = inp.name + \" has a recording here\";\n        bar.appendChild(el);\n      });\n    });\n  }\n\n  function inputName(iid) {\n    for (var i = 0; i < inputs.length; i++) {\n      if (String(inputs[i].id) === String(iid)) return inputs[i].name || iid;\n    }\n    return iid || \"\";\n  }\n\n  function clearPicture(v) {\n    if (!v.getAttribute(\"data-src\") && !v.getAttribute(\"src\")) {\n      if (!v.paused) v.pause();\n      return;\n    }\n    if (!v.paused) v.pause();\n    v.removeAttribute(\"src\");\n    v.removeAttribute(\"data-src\");\n    v.removeAttribute(\"data-start\");\n    v.removeAttribute(\"data-end\");\n    try { v.load(); } catch (e) {}\n  }\n\n  function showPaneNote(pane, v, kind, text) {\n    pane.classList.toggle(\"norec\", kind === \"gap\");\n    var ph = pane.querySelector(\".ph\");\n    if (ph) {\n      ph.classList.toggle(\"gap\", kind === \"gap\");\n      ph.textContent = text;\n      ph.style.display = \"\";\n    }\n    if (kind !== \"media\") clearPicture(v);\n  }\n\n  function loadChunk(v, pane, hit, off) {\n    var want = \"/api/chunks/\" + hit.id + \"/media\";\n    var startMs = Date.parse(hit.start_at);\n    v.setAttribute(\"data-start\", String(startMs));\n    v.setAttribute(\"data-end\", String(Date.parse(hit.end_at || hit.start_at)));\n    if (v.getAttribute(\"data-src\") === want) return false;\n    v.src = want;\n    v.setAttribute(\"data-src\", want);\n    pane.classList.remove(\"norec\");\n    var ph = pane.querySelector(\".ph\");\n    if (ph) {\n      ph.classList.remove(\"gap\");\n      ph.style.display = \"none\";\n    }\n    v.onloadeddata = function () {\n      v.onloadeddata = null;\n      try { v.currentTime = off; } catch (e) {}\n      if (playing) v.play().catch(function () {});\n    };\n    return true;\n  }\n\n  function syncMedia(followSelected) {\n    document.querySelectorAll(\"#grid .pane\").forEach(function (pane, i) {\n      var v = pane.querySelector(\"video\");\n      if (!v) return;\n      var audible = playing && i === selected;\n      v.muted = !audible;\n      if (audible) v.volume = volume;\n      var iid = v.getAttribute(\"data-input\");\n      if (!iid) {\n        showPaneNote(pane, v, \"empty\", \"no input\");\n        return;\n      }\n      var hit = chunkHit(iid, play);\n      if (!hit || !hit.path || String(hit.path).indexOf(\"/tmp/nexrec-fixture\") === 0) {\n        showPaneNote(pane, v, \"gap\", \"No recording for \" + inputName(iid) + \" at this time\");\n        return;\n      }\n      var off = Math.max(0, (play - Date.parse(hit.start_at)) / 1000);\n      if (loadChunk(v, pane, hit, off)) return;\n      var skipSeek = followSelected && i === selected && !v.paused;\n      if (!skipSeek && Math.abs((v.currentTime || 0) - off) > 0.35) {\n        try { v.currentTime = off; } catch (e) {}\n      }\n      if (playing) {\n        if (v.paused) v.play().catch(function () {});\n      } else if (!v.paused) {\n        v.pause();\n      }\n    });\n  }\n\n  function advanceChunk() {\n    var v = selectedVideo();\n    var end = v ? Number(v.getAttribute(\"data-end\")) : NaN;\n    play = isFinite(end) ? end : play;\n    if (play >= t1) {\n      play = t1;\n      stopPlayback();\n      paintChrome();\n      return;\n    }\n    var iid = v && v.getAttribute(\"data-input\");\n    if (!iid || !chunkHit(iid, play)) {\n      stopPlayback();\n      paintChrome();\n      return;\n    }\n    syncMedia(false);\n  }\n\n  function onSelectedTime(ev) {\n    if (!playing) return;\n    var v = selectedVideo();\n    if (!v || ev.target !== v || v.seeking || v.paused) return;\n    var start = Number(v.getAttribute(\"data-start\"));\n    if (!isFinite(start)) return;\n    var iid = v.getAttribute(\"data-input\");\n    var loaded = iid ? chunkHit(iid, start + 1) : null;\n    if (!loaded || v.getAttribute(\"data-src\") !== \"/api/chunks/\" + loaded.id + \"/media\") return;\n    var next = start + v.currentTime * 1000;\n    var end = Number(v.getAttribute(\"data-end\"));\n    if (isFinite(end) && next > end + 250) return;\n    play = Math.min(t1, next);\n    paintChrome();\n    syncMedia(true);\n  }\n\n  function onSelectedEnded(ev) {\n    if (!playing || ev.target !== selectedVideo()) return;\n    advanceChunk();\n  }\n\n  function tick() {\n    paintChrome();\n    syncMedia(false);\n  }\n\n  function render() {\n    if (selected >= n) selected = 0;\n    var grid = document.getElementById(\"grid\");\n    grid.className = \"grid n\" + n;\n    grid.innerHTML = \"\";\n    var ids = visibleIds();\n    var slots = NexRecUI.paneInputs(inputs, ids, n);\n    slots.forEach(function (inp, i) {\n      var pane = document.createElement(\"div\");\n      pane.className = \"pane\" + (i === selected ? \" selected\" : \"\");\n      pane.setAttribute(\"data-slot\", String(i));\n      var pick = document.createElement(\"div\");\n      pick.className = \"pick\";\n      var sel = document.createElement(\"select\");\n      sel.setAttribute(\"aria-label\", \"Input for pane \" + (i + 1));\n      var blank = document.createElement(\"option\");\n      blank.value = \"\";\n      blank.textContent = \"No input\";\n      sel.appendChild(blank);\n      inputs.forEach(function (row) {\n        var opt = document.createElement(\"option\");\n        opt.value = String(row.id);\n        opt.textContent = row.name || row.id;\n        sel.appendChild(opt);\n      });\n      sel.value = ids[i] || \"\";\n      sel.addEventListener(\"mousedown\", function () { choosePane(i); });\n      sel.addEventListener(\"change\", function () { assignPane(i, sel.value); });\n      pick.appendChild(sel);\n      var video = document.createElement(\"video\");\n      video.setAttribute(\"data-input\", inp ? String(inp.id) : \"\");\n      video.muted = true; video.playsInline = true; video.controls = false;\n      video.addEventListener(\"timeupdate\", onSelectedTime);\n      video.addEventListener(\"ended\", onSelectedEnded);\n      var ph = document.createElement(\"div\");\n      ph.className = \"ph\";\n      ph.textContent = inp ? \"time-locked chunk preview\" : \"no input\";\n      pane.appendChild(video); pane.appendChild(ph); pane.appendChild(pick);\n      pane.addEventListener(\"click\", function () { choosePane(i); });\n      var cell = document.createElement(\"div\");\n      cell.className = \"slot\";\n      cell.appendChild(pane);\n      grid.appendChild(cell);\n    });\n  }\n\n  function inputLabel(job) {\n    var ids = job.input_ids;\n    if (typeof ids === \"string\") {\n      try { ids = JSON.parse(ids); } catch (e) { ids = [ids]; }\n    }\n    return (ids || []).join(\", \");\n  }\n  function statusText(job) {\n    if (job.status === \"running\") {\n      var pct = job.progress_pct == null || job.progress_pct === \"\" ? \"\" : \" \" + Number(job.progress_pct).toFixed(0) + \"%\";\n      if (Number(job.cancel_requested) === 1) return \"cancelling\" + pct;\n      return \"running\" + pct;\n    }\n    if (job.status === \"error\" && job.error) return \"error\";\n    return job.status || \"\";\n  }\n  function paintJobs(jobs) {\n    var tb = document.getElementById(\"jobs\");\n    var me = (NexRecAuth.currentUser && NexRecAuth.currentUser()) || {};\n    var can = me.role === \"admin\" || me.role === \"operator\";\n    var focus = (location.hash || \"\").replace(/^#/, \"\");\n    if (!jobs.length) {\n      tb.innerHTML = '<tr><td colspan=\"7\">Queue is empty.</td></tr>';\n      return;\n    }\n    var now = Date.now();\n    tb.innerHTML = jobs.map(function (j) {\n      var eta = (j.status === \"queued\" || j.status === \"running\")\n        ? NexRecUI.formatEta(NexRecUI.exportQueueEta(jobs, j, now)) : \"—\";\n      var bits = [];\n      if (j.status === \"done\") bits.push('<a href=\"/api/exports/' + encodeURIComponent(j.id) + '/file\">download</a>');\n      if (can && (j.status === \"queued\" || j.status === \"running\") && Number(j.cancel_requested) !== 1) {\n        bits.push('<button type=\"button\" data-act=\"export_cancel\" data-id=\"' + esc(j.id) + '\">Cancel</button>');\n      }\n      if (can && (j.status === \"error\" || j.status === \"cancelled\")) {\n        bits.push('<button type=\"button\" data-act=\"export_retry\" data-id=\"' + esc(j.id) + '\">Retry</button>');\n      }\n      if (can && j.status !== \"running\") {\n        bits.push('<button type=\"button\" data-act=\"export_remove\" data-id=\"' + esc(j.id) + '\">Remove</button>');\n      }\n      var who = j.created_by ? '<div class=\"sub\">' + esc(j.created_by) + \"</div>\" : \"\";\n      var err = j.status === \"error\" && j.error ? '<div class=\"sub\">' + esc(j.error) + \"</div>\" : \"\";\n      return '<tr id=\"job-' + esc(j.id) + '\"' + (j.id === focus ? ' class=\"job-focus\"' : \"\") + \">\" +\n        \"<td>\" + esc(j.id) + who + \"</td>\" +\n        \"<td>\" + esc(station(j.t_in) + \" → \" + station(j.t_out)) + \"</td>\" +\n        \"<td>\" + esc(inputLabel(j)) + \"</td>\" +\n        \"<td>\" + esc(j.quality || \"\") + \"</td>\" +\n        \"<td>\" + esc(statusText(j)) + err + \"</td>\" +\n        \"<td>\" + esc(eta) + \"</td>\" +\n        \"<td>\" + bits.join(\" \") + \"</td></tr>\";\n    }).join(\"\");\n    if (focus && scrolledJob !== focus) {\n      var row = document.getElementById(\"job-\" + focus);\n      if (row) {\n        row.scrollIntoView({ block: \"center\" });\n        scrolledJob = focus;\n      }\n    }\n  }\n  document.getElementById(\"jobs\").addEventListener(\"click\", function (ev) {\n    var btn = ev.target.closest(\"button[data-act]\");\n    if (!btn) return;\n    var act = btn.getAttribute(\"data-act\");\n    var id = btn.getAttribute(\"data-id\");\n    if (act === \"export_remove\" && !window.confirm(\"Remove this export?\")) return;\n    NexRecAuth.recApi(act, { id: id }).then(function () {\n      return NexRecAuth.refreshExports();\n    }).catch(function (e) {\n      var msg = document.getElementById(\"msg\");\n      msg.style.color = \"var(--bad)\";\n      msg.textContent = e.message;\n    });\n  });\n  window.addEventListener(\"nexrec-exports\", function (ev) {\n    paintJobs(ev.detail || []);\n  });\n\n  document.getElementById(\"layout-seg\").addEventListener(\"click\", function (ev) {\n    var btn = ev.target.closest(\"button[data-n]\");\n    if (!btn) return;\n    n = parseInt(btn.getAttribute(\"data-n\"), 10);\n    document.querySelectorAll(\"#layout-seg button\").forEach(function (b) { b.classList.toggle(\"active\", b === btn); });\n    render(); tick();\n  });\n  function seekTo(ms) {\n    play = Math.max(t0, Math.min(t1, ms));\n    var one = selectedInput();\n    if (playing && (!one || !chunkHit(one.id, play) || play >= t1)) stopPlayback();\n    tick();\n  }\n  document.getElementById(\"play-toggle\").onclick = function () {\n    if (playing) {\n      stopPlayback();\n      return;\n    }\n    var one = selectedInput();\n    if (!one || !chunkHit(one.id, play) || play >= t1) return;\n    playing = true;\n    paintPlayButton();\n    syncMedia(false);\n  };\n  document.getElementById(\"listen-vol\").addEventListener(\"input\", function (ev) {\n    volume = Math.max(0, Math.min(1, Number(ev.target.value)));\n    if (!Number.isFinite(volume)) volume = 0.8;\n    try { localStorage.setItem(VOL_KEY, String(volume)); } catch (e) {}\n    var v = selectedVideo();\n    if (v && playing && !v.muted) v.volume = volume;\n  });\n  function setWindow(startMs, endMs) {\n    var note = document.getElementById(\"coverage-note\");\n    if (!isFinite(startMs) || !isFinite(endMs)) {\n      note.textContent = \"Use station time YYYY-MM-DD HH:MM:SS.\";\n      return;\n    }\n    if (endMs <= startMs) {\n      note.textContent = \"Range end must be after the start.\";\n      return;\n    }\n    t0 = startMs;\n    t1 = endMs;\n    if (play < t0 || play > t1) {\n      play = t0;\n      stopPlayback();\n    }\n    fillRangeFields();\n    tick();\n  }\n  document.getElementById(\"range-apply\").onclick = function () {\n    setWindow(\n      NexRecUI.parseStation(document.getElementById(\"range-start\").value),\n      NexRecUI.parseStation(document.getElementById(\"range-end\").value)\n    );\n  };\n  document.getElementById(\"range-start\").addEventListener(\"keydown\", function (ev) {\n    if (ev.key === \"Enter\") document.getElementById(\"range-apply\").click();\n  });\n  document.getElementById(\"range-end\").addEventListener(\"keydown\", function (ev) {\n    if (ev.key === \"Enter\") document.getElementById(\"range-apply\").click();\n  });\n  document.getElementById(\"range-hour\").onclick = function () {\n    var end = archive1;\n    var start = Math.max(archive0, end - 3600000);\n    if (end <= start) start = archive0;\n    setWindow(start, end);\n  };\n  document.getElementById(\"range-all\").onclick = function () {\n    setWindow(archive0, archive1);\n  };\n  document.getElementById(\"scrub\").addEventListener(\"input\", function (ev) {\n    seekTo(t0 + (Number(ev.target.value) / 1000) * (t1 - t0));\n  });\n  document.getElementById(\"timeline\").addEventListener(\"click\", function (ev) {\n    var r = ev.currentTarget.getBoundingClientRect();\n    seekTo(t0 + ((ev.clientX - r.left) / r.width) * (t1 - t0));\n  });\n  document.getElementById(\"mark-in\").onclick = function () { markIn = play; tick(); };\n  document.getElementById(\"mark-out\").onclick = function () { markOut = play; tick(); };\n  document.getElementById(\"do-export\").onclick = function () {\n    var msg = document.getElementById(\"msg\");\n    msg.textContent = \"\";\n    if (markIn == null || markOut == null || markOut <= markIn) {\n      msg.textContent = \"mark I before O\"; msg.style.color = \"var(--bad)\"; return;\n    }\n    var visible = NexRecUI.paneInputs(inputs, visibleIds(), n).filter(Boolean);\n    var scope = document.getElementById(\"scope\").value;\n    var one = selectedInput();\n    var ids = scope === \"all\" ? visible.map(function (x) { return x.id; }) : (one ? [one.id] : []);\n    if (!ids.length) { msg.textContent = \"no inputs\"; return; }\n    NexRecAuth.recApi(\"export_create\", {\n      input_ids: ids,\n      t_in: iso(markIn),\n      t_out: iso(markOut),\n      quality: document.getElementById(\"quality\").value,\n      scope: scope,\n    }).then(function (d) {\n      msg.style.color = \"var(--ok)\";\n      msg.textContent = \"Export received.\";\n      if (NexRecAuth.noteExportReceived) NexRecAuth.noteExportReceived(d.export_id);\n      return NexRecAuth.refreshExports();\n    }).then(function (d) { paintJobs((d && d.exports) || []); })\n      .catch(function (e) { msg.style.color = \"var(--bad)\"; msg.textContent = e.message; });\n  };\n  document.getElementById(\"measure-lkfs\").onclick = function () {\n    var msg = document.getElementById(\"lkfs-msg\");\n    if (markIn == null || markOut == null || markOut <= markIn) {\n      msg.textContent = \"mark I before O\";\n      return;\n    }\n    var one = selectedInput();\n    var iid = one && one.id;\n    if (!iid) { msg.textContent = \"no input\"; return; }\n    var tin = iso(markIn), tout = iso(markOut);\n    NexRecAuth.recApi(\"loudness_enqueue\", { input_id: iid, t_in: tin, t_out: tout }).then(function (d) {\n      msg.textContent = \"queued \" + d.job_id + \" — python3 worker/nexrec-analyze.py --once\";\n      return NexRecAuth.recApi(\"loudness_chart\", { input_id: iid, t_in: tin, t_out: tout });\n    }).then(function (d) {\n      var pts = (d.samples || []).map(function (s, i, arr) {\n        var x = arr.length > 1 ? (i / (arr.length - 1)) * 1000 : 0;\n        var y = 75 - ((Number(s.lkfs) + 24) / 16) * 50;\n        if (y < 4) y = 4; if (y > 146) y = 146;\n        return x.toFixed(1) + \",\" + y.toFixed(1);\n      });\n      document.getElementById(\"lkfs-line\").setAttribute(\"points\", pts.join(\" \"));\n      if (!(d.samples || []).length) {\n        msg.textContent = (msg.textContent || \"\") + \" · no samples yet (run analyze worker)\";\n      }\n    }).catch(function (e) { msg.textContent = e.message; });\n  };\n})();\n</script>\n</body>\n</html>\n"
