          "content": {
            "size": 11206,
            "mimeType": "text/html",
            "compression": 8040,
            "text": "<!DOCTYPE html>\n<html lang=\"en\" data-theme=\"dark\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>NexCLIP Recorder — Live</title>\n<link rel=\"stylesheet\" href=\"/assets/nexrec.css\">\n<script src=\"/assets/nexrec-ui.js\"></script>\n</head>\n<body class=\"stage-page\">\n<nav class=\"topnav\">\n  <a class=\"brand\" href=\"/live\">NexCLIP Recorder</a>\n  <a class=\"active\" href=\"/live\">Live</a>\n  <a href=\"/export\">Export</a>\n  <a href=\"/metrics\" data-auth-role=\"admin,operator\">Metrics</a>\n  <a href=\"/inputs\" data-auth-role=\"admin,operator\">Inputs</a>\n  <a href=\"/settings\" data-auth-role=\"admin,operator\">Setup</a>\n  <a href=\"/users\" data-auth-role=\"admin\">Users</a>\n  <a href=\"/services\" data-auth-role=\"admin\">Services</a>\n  <button type=\"button\" class=\"theme-toggle\" id=\"theme-toggle\">Light</button>\n  <span class=\"nav-version\" id=\"nav-version\" hidden></span>\n  <span class=\"nav-who\" id=\"nav-who\" hidden></span>\n  <button type=\"button\" class=\"nav-logout\" id=\"nav-logout\">Log out</button>\n</nav>\n<main>\n  <div class=\"bar\">\n    <span class=\"meta\">Layout</span>\n    <div class=\"seg\" id=\"layout-seg\">\n      <button type=\"button\" data-n=\"1\" class=\"active\">1</button>\n      <button type=\"button\" data-n=\"2\">2</button>\n      <button type=\"button\" data-n=\"3\">3</button>\n      <button type=\"button\" data-n=\"4\">4</button>\n      <button type=\"button\" data-n=\"6\">6</button>\n    </div>\n    <span class=\"meta\">Monitors</span>\n    <div class=\"seg\" id=\"monitor-seg\" title=\"Confidence scopes on the selected pane, from the decoded WHEP preview. Default off, saved in this browser. Not burned into the record. The RTA is 64 bands on the stereo listen pair — 64-channel SDI/AES embed metering is NEXT.\">\n      <button type=\"button\" data-mon=\"scopes\" aria-pressed=\"false\">Scopes</button>\n      <button type=\"button\" data-mon=\"vu\" aria-pressed=\"false\">VU</button>\n      <button type=\"button\" data-mon=\"rta\" aria-pressed=\"false\">RTA</button>\n    </div>\n    <span class=\"meta\">Audio</span>\n    <button type=\"button\" class=\"tgl\" id=\"listen-toggle\" aria-pressed=\"false\" title=\"Play the selected pane's preview in this browser. The picture stays muted.\">Listen</button>\n    <input type=\"range\" id=\"listen-vol\" class=\"listen-vol\" min=\"0\" max=\"1\" step=\"0.05\" value=\"0.2\" aria-label=\"Preview listen volume\">\n    <span class=\"meta\" id=\"clock\">—</span>\n    <span class=\"meta\" id=\"monitor-hint\">Confidence monitors follow the selected pane (decoded preview, not the record). Stereo AAC proxy.</span>\n  </div>\n  <div class=\"grid n1\" id=\"grid\"></div>\n</main>\n<script src=\"/assets/nexrec-scopes.js\"></script>\n<script src=\"/assets/nexrec-vu.js\"></script>\n<script src=\"/assets/nexrec-spectrum.js\"></script>\n<script src=\"/assets/nexrec-auth-gate.js\"></script>\n<script>\n(function () {\n  var n = 1;\n  var inputs = [];\n  var selected = 0;\n  var slotIds = null;\n  var SLOT_KEY = \"nexrec-live-slots\";\n  var monitors = null;\n  var clockTimers = [];\n  NexRecAuth.requirePage().then(load);\n  syncToggles();\n  syncListen();\n\n  function listeningNow() {\n    if (monitors && monitors.vu) return monitors.vu.isListening();\n    return window.NexRecVu ? !NexRecVu.getMutedPref() : false;\n  }\n\n  function syncListen() {\n    var btn = document.getElementById(\"listen-toggle\");\n    var vol = document.getElementById(\"listen-vol\");\n    var on = listeningNow();\n    if (btn) {\n      btn.textContent = on ? \"Mute\" : \"Listen\";\n      btn.classList.toggle(\"active\", on);\n      btn.setAttribute(\"aria-pressed\", on ? \"true\" : \"false\");\n    }\n    if (vol && window.NexRecVu && document.activeElement !== vol) {\n      vol.value = String(NexRecVu.getVolumePref());\n    }\n  }\n\n  function syncToggles() {\n    var map = {\n      scopes: window.NexRecScopes && NexRecScopes.getOnPref(),\n      vu: window.NexRecVu && NexRecVu.getVisiblePref(),\n      rta: window.NexRecSpectrum && NexRecSpectrum.getOnPref()\n    };\n    document.querySelectorAll(\"#monitor-seg button[data-mon]\").forEach(function (btn) {\n      var on = !!map[btn.getAttribute(\"data-mon\")];\n      btn.classList.toggle(\"active\", on);\n      btn.setAttribute(\"aria-pressed\", on ? \"true\" : \"false\");\n    });\n  }\n\n  function destroyMonitors() {\n    if (!monitors) return;\n    try { monitors.spectrum.destroy(); } catch (e) {}\n    try { monitors.vu.detach(); } catch (e) {}\n    try { monitors.scopes.destroy(); } catch (e) {}\n    monitors = null;\n  }\n\n  function bindMonitors() {\n    destroyMonitors();\n    var pane = document.querySelector(\"#grid .pane.selected\");\n    if (!pane || !window.NexRecScopes || !window.NexRecVu || !window.NexRecSpectrum) {\n      syncListen();\n      return;\n    }\n    var video = pane.querySelector(\"video\");\n    if (!video) return;\n    var vu = NexRecVu.attach({\n      container: pane,\n      video: video,\n      floatable: true,\n      stream: video.srcObject || null\n    });\n    var scopes = NexRecScopes.attach({ container: pane, video: video });\n    var spectrum = NexRecSpectrum.attach({ container: pane, vu: vu });\n    monitors = { vu: vu, scopes: scopes, spectrum: spectrum, video: video };\n    function syncStream() {\n      if (!monitors || monitors.video !== video) return;\n      if (video.srcObject) vu.setStream(video.srcObject);\n    }\n    video.addEventListener(\"loadedmetadata\", syncStream);\n    video.addEventListener(\"canplay\", syncStream);\n    video.addEventListener(\"playing\", syncStream);\n    syncStream();\n    syncToggles();\n    syncListen();\n  }\n\n  function clearClockTimers() {\n    clockTimers.forEach(function (id) { clearInterval(id); });\n    clockTimers = [];\n  }\n\n  function load() {\n    return NexRecAuth.recApi(\"inputs_list\").then(function (data) {\n      inputs = data.inputs || [];\n      if (slotIds == null) slotIds = NexRecUI.readPaneSlots(localStorage, SLOT_KEY);\n      render();\n    });\n  }\n\n  function visibleIds() {\n    return NexRecUI.paneSlotIds(inputs, slotIds);\n  }\n\n  function choosePane(i) {\n    if (selected === i) return;\n    selected = i;\n    document.querySelectorAll(\"#grid .pane\").forEach(function (p, idx) {\n      p.classList.toggle(\"selected\", idx === selected);\n    });\n    bindMonitors();\n  }\n\n  function assignPane(i, inputId) {\n    slotIds = NexRecUI.paneAssign(visibleIds(), i, inputId);\n    NexRecUI.writePaneSlots(localStorage, SLOT_KEY, slotIds);\n    selected = i;\n    render();\n  }\n\n  function render() {\n    if (selected >= n) selected = 0;\n    clearClockTimers();\n    destroyMonitors();\n    var grid = document.getElementById(\"grid\");\n    grid.className = \"grid n\" + n;\n    grid.innerHTML = \"\";\n    var ids = visibleIds();\n    var slots = NexRecUI.paneInputs(inputs, ids, n);\n    slots.forEach(function (inp, i) {\n      var pane = document.createElement(\"div\");\n      pane.className = \"pane\" + (i === selected ? \" selected\" : \"\");\n      pane.setAttribute(\"data-slot\", String(i));\n      var pick = document.createElement(\"div\");\n      pick.className = \"pick\";\n      var sel = document.createElement(\"select\");\n      sel.setAttribute(\"aria-label\", \"Input for pane \" + (i + 1));\n      var blank = document.createElement(\"option\");\n      blank.value = \"\";\n      blank.textContent = \"No input\";\n      sel.appendChild(blank);\n      inputs.forEach(function (row) {\n        var opt = document.createElement(\"option\");\n        opt.value = String(row.id);\n        opt.textContent = row.name || row.id;\n        sel.appendChild(opt);\n      });\n      sel.value = ids[i] || \"\";\n      sel.addEventListener(\"mousedown\", function () { choosePane(i); });\n      sel.addEventListener(\"change\", function () { assignPane(i, sel.value); });\n      pick.appendChild(sel);\n      if (inp && inp.feat_monitors) {\n        var mon = document.createElement(\"span\");\n        mon.className = \"mon\";\n        mon.textContent = \"mon\";\n        pick.appendChild(mon);\n      }\n      var clock = document.createElement(\"div\");\n      clock.className = \"clock\";\n      clock.textContent = \"—\";\n      var video = document.createElement(\"video\");\n      video.autoplay = true;\n      video.muted = true;\n      video.playsInline = true;\n      var ph = document.createElement(\"div\");\n      ph.className = \"ph\";\n      ph.innerHTML = inp\n        ? '<span class=\"rec-dot\"></span><span>' + (inp.preview_path || \"in0\") + ' WHEP</span><span>proxy preview</span>'\n        : \"<span>no input</span>\";\n      pane.appendChild(video);\n      pane.appendChild(ph);\n      pane.appendChild(pick);\n      pane.appendChild(clock);\n      pane.addEventListener(\"click\", function () { choosePane(i); });\n      var cell = document.createElement(\"div\");\n      cell.className = \"slot\";\n      cell.appendChild(pane);\n      grid.appendChild(cell);\n      if (inp && inp.preview_path) {\n        NexRecAuth.whepConnect(video, inp.preview_path).then(function () {\n          if (video.srcObject) ph.style.display = \"none\";\n          if (monitors && monitors.video === video && video.srcObject) {\n            monitors.vu.setStream(video.srcObject);\n          }\n        });\n      }\n      clockTimers.push(setInterval(function () {\n        clock.textContent = NexRecUI.formatStation(new Date());\n      }, 250));\n    });\n    bindMonitors();\n  }\n\n  document.getElementById(\"layout-seg\").addEventListener(\"click\", function (ev) {\n    var btn = ev.target.closest(\"button[data-n]\");\n    if (!btn) return;\n    n = parseInt(btn.getAttribute(\"data-n\"), 10);\n    document.querySelectorAll(\"#layout-seg button\").forEach(function (b) {\n      b.classList.toggle(\"active\", b === btn);\n    });\n    render();\n  });\n\n  document.getElementById(\"monitor-seg\").addEventListener(\"click\", function (ev) {\n    var btn = ev.target.closest(\"button[data-mon]\");\n    if (!btn) return;\n    var which = btn.getAttribute(\"data-mon\");\n    if (which === \"scopes\" && window.NexRecScopes) {\n      var onS = monitors && monitors.scopes ? !monitors.scopes.isVisible() : !NexRecScopes.getOnPref();\n      if (monitors && monitors.scopes) monitors.scopes.setVisible(onS);\n      else NexRecScopes.setOnPref(onS);\n    } else if (which === \"vu\" && window.NexRecVu) {\n      var onV = monitors && monitors.vu ? !monitors.vu.getVisible() : !NexRecVu.getVisiblePref();\n      if (monitors && monitors.vu) monitors.vu.setVisible(onV);\n      else NexRecVu.setVisiblePref(onV);\n    } else if (which === \"rta\" && window.NexRecSpectrum) {\n      var onR = monitors && monitors.spectrum ? !monitors.spectrum.isVisible() : !NexRecSpectrum.getOnPref();\n      if (monitors && monitors.spectrum) monitors.spectrum.setVisible(onR);\n      else NexRecSpectrum.setOnPref(onR);\n    }\n    syncToggles();\n  });\n\n  document.getElementById(\"listen-toggle\").addEventListener(\"click\", function () {\n    var next = !listeningNow();\n    if (monitors && monitors.vu) monitors.vu.setListen(next);\n    else if (window.NexRecVu) {\n      NexRecVu.setMutedPref(!next);\n      if (next) NexRecVu.resume();\n    }\n    syncListen();\n  });\n\n  document.getElementById(\"listen-vol\").addEventListener(\"input\", function (ev) {\n    var v = Number(ev.target.value);\n    if (monitors && monitors.vu) monitors.vu.setVolume(v);\n    else if (window.NexRecVu) NexRecVu.setVolumePref(v);\n  });\n\n  setInterval(function () {\n    document.getElementById(\"clock\").textContent = NexRecUI.formatStation(new Date(), true);\n  }, 500);\n})();\n</script>\n</body>\n</html>\n"
          },
