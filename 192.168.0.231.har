          "content": {
            "size": 19382,
            "mimeType": "application/json",
            "compression": -13,
            "text": "{\"ok\":true,\"settings\":{\"station.display_name\":\"Studio Recorder 01\",\"station.instance_id\":\"dcwasof2nexrec01\",\"station.public_url\":\"\",\"station.timezone\":\"America/New_York\",\"station.ntp_notes\":\"\",\"database.host\":\"127.0.0.1\",\"database.port\":\"5432\",\"database.name\":\"nexrec\",\"database.user\":\"nexrec\",\"storage.recordings\":\"/var/lib/nexrec/storage\",\"storage.exports\":\"/var/lib/nexrec/storage/exports\",\"storage.scratch\":\"/var/lib/nexrec/storage/tmp\",\"storage.free_space_floor\":\"50G\",\"storage.max_used_percent\":\"98\",\"storage.purge_warn_points\":\"5\",\"retention.raw_days\":\"2\",\"retention.export_days\":\"15\",\"ffmpeg.path\":\"/usr/local/bin/ffmpeg\",\"ffmpeg.probe\":\"/usr/local/bin/ffprobe\",\"ffmpeg.video_bitrate\":\"12M\",\"ffmpeg.audio_bitrate\":\"192k\",\"ffmpeg.encoder\":\"auto\",\"ffmpeg.preset\":\"veryfast\",\"ffmpeg.segment_seconds\":\"300\",\"ffmpeg.gop_frames\":\"60\",\"ffmpeg.decklink_status_bin\":\"\",\"preview.enabled\":\"1\",\"preview.mediamtx_rtsp\":\"rtsp://127.0.0.1:8554\",\"preview.whep_port\":\"8889\",\"preview.whep_tls\":\"0\",\"defaults.live_transcode\":\"0\",\"defaults.copy_native\":\"1\",\"defaults.upconvert_1080i\":\"0\",\"defaults.preview_enabled\":\"1\",\"defaults.max_inputs\":\"10\",\"defaults.feat_scte\":\"0\",\"defaults.feat_av_anomaly\":\"0\",\"defaults.feat_captions\":\"0\",\"defaults.feat_transcribe\":\"0\",\"defaults.feat_nielsen\":\"0\",\"defaults.feat_monitors\":\"0\",\"nexapp.enabled\":\"0\",\"nexapp.mode\":\"standalone\",\"nexapp.base_url\":\"\",\"nexapp.issuer\":\"\",\"nexapp.service_id\":\"nexclip-recorder-ctl1\",\"nexapp.public_key_path\":\"/var/www/nexapp/keys/jwt_public.pem\",\"nexapp.access_url\":\"\",\"nexapp.redeem_url\":\"\",\"nexapp.logout_url\":\"\",\"nexapp.wan_redeem_secret_ref\":\"env:NEXAPP_LAUNCH_SECRET\",\"nexclip.enabled\":\"0\",\"nexclip.api_base\":\"\",\"nexclip.api_prefix\":\"/api/v1\",\"nexclip.enrollment_secret_ref\":\"env:NEXCLIP_ENROLLMENT_SECRET\",\"nexclip.recorder_id\":\"\",\"nexclip.poll_s\":\"60\",\"nexclip.num_slots\":\"8\",\"ldap.enabled\":\"0\",\"ldap.url\":\"\",\"ldap.bind_dn\":\"\",\"ldap.base_dn\":\"\",\"ldap.user_filter\":\"(uid=%s)\",\"ldap.email_attr\":\"mail\",\"ldap.display_attr\":\"cn\",\"intelligence.transcribe_engine\":\"none\",\"intelligence.transcribe_cmd\":\"\",\"intelligence.transcribe_timeout_s\":\"300\",\"intelligence.loudness_timeout_s\":\"180\",\"intelligence.nielsen_cmd\":\"\"},\"fields\":[{\"key\":\"station.display_name\",\"value\":\"Studio Recorder 01\",\"source\":\"db\",\"section\":\"station\",\"section_label\":\"Station\",\"label\":\"Display name\",\"type\":\"string\",\"help\":\"Hostname shown in the UI and sent when this box registers with NexClip.\"},{\"key\":\"station.instance_id\",\"value\":\"dcwasof2nexrec01\",\"source\":\"db\",\"section\":\"station\",\"section_label\":\"Station\",\"label\":\"Hostname id\",\"type\":\"ident\",\"help\":\"Stable name for this recorder. Not a NexAPP grant key \\u2014 each host has its own service_id.\"},{\"key\":\"station.public_url\",\"value\":\"\",\"source\":\"db\",\"section\":\"station\",\"section_label\":\"Station\",\"label\":\"Public URL\",\"type\":\"url\",\"help\":\"HTTPS origin operators and NexClip use to reach this box.\"},{\"key\":\"station.timezone\",\"value\":\"America/New_York\",\"source\":\"db\",\"section\":\"station\",\"section_label\":\"Station\",\"label\":\"Timezone\",\"type\":\"string\",\"help\":\"UI clock (EST/EDT, including the DST change). Recordings, filenames, and timecode stay UTC. The OS zone is America/New_York; chrony corrects it about once or twice an hour.\"},{\"key\":\"station.ntp_notes\",\"value\":\"\",\"source\":\"db\",\"section\":\"station\",\"section_label\":\"Station\",\"label\":\"NTP / timecode notes\",\"type\":\"text\",\"help\":\"Operator notes (chrony source, house timecode). Not read by FFmpeg.\"},{\"key\":\"database.host\",\"value\":\"127.0.0.1\",\"source\":\"db\",\"section\":\"database\",\"section_label\":\"Database\",\"label\":\"Postgres host\",\"type\":\"string\",\"help\":\"Local PostgreSQL on this recorder. The process connects with nexrec.env. Edit that file and restart to move the server. Password stays in nexrec.env.\"},{\"key\":\"database.port\",\"value\":\"5432\",\"source\":\"db\",\"section\":\"database\",\"section_label\":\"Database\",\"label\":\"Postgres port\",\"type\":\"int\",\"help\":\"Bootstrap copy of NEXREC_PGPORT.\"},{\"key\":\"database.name\",\"value\":\"nexrec\",\"source\":\"db\",\"section\":\"database\",\"section_label\":\"Database\",\"label\":\"Database name\",\"type\":\"string\",\"help\":\"Bootstrap copy of NEXREC_PGDATABASE.\"},{\"key\":\"database.user\",\"value\":\"nexrec\",\"source\":\"db\",\"section\":\"database\",\"section_label\":\"Database\",\"label\":\"Database user\",\"type\":\"string\",\"help\":\"Bootstrap copy of NEXREC_PGUSER. The password is NEXREC_PGPASSWORD in nexrec.env and is not stored here.\"},{\"key\":\"storage.recordings\",\"value\":\"/var/lib/nexrec/storage\",\"source\":\"db\",\"section\":\"storage\",\"section_label\":\"Storage\",\"label\":\"Recordings path\",\"type\":\"path\",\"help\":\"Where chunks, exports, and scratch are stored. First boot seeds $NEXREC_DATA_DIR/storage (usually /var/lib/nexrec/storage). Blank still means that path. Exports and scratch stay underneath unless set below. Saving a new path does not move files already written; restart record and cleanup to use it.\"},{\"key\":\"storage.exports\",\"value\":\"/var/lib/nexrec/storage/exports\",\"source\":\"db\",\"section\":\"storage\",\"section_label\":\"Storage\",\"label\":\"Exports path\",\"type\":\"path\",\"help\":\"Finished exports. Blank uses <recordings>/exports.\"},{\"key\":\"storage.scratch\",\"value\":\"/var/lib/nexrec/storage/tmp\",\"source\":\"db\",\"section\":\"storage\",\"section_label\":\"Storage\",\"label\":\"Scratch path\",\"type\":\"path\",\"help\":\"Concat/trim scratch. Blank uses <recordings>/tmp. Prefer NVMe.\"},{\"key\":\"storage.free_space_floor\",\"value\":\"50G\",\"source\":\"db\",\"section\":\"storage\",\"section_label\":\"Storage\",\"label\":\"Free-space floor\",\"type\":\"size\",\"help\":\"Hard reserve. Cleanup deletes oldest video while free space is below this. Example: 50G, 512M.\"},{\"key\":\"storage.max_used_percent\",\"value\":\"98\",\"source\":\"db\",\"section\":\"storage\",\"section_label\":\"Storage\",\"label\":\"Max drive used (%)\",\"type\":\"int\",\"help\":\"Cleanup also deletes oldest video once the recordings filesystem reaches this percent full. The free-space floor still applies. Changing this does not move files.\"},{\"key\":\"storage.purge_warn_points\",\"value\":\"5\",\"source\":\"db\",\"section\":\"storage\",\"section_label\":\"Storage\",\"label\":\"Purge warning (points before max)\",\"type\":\"int\",\"help\":\"Show the drive warning bar this many percentage points before Max drive used. At 90% with 5 points, the bar appears at 85%.\"},{\"key\":\"retention.raw_days\",\"value\":\"2\",\"source\":\"db\",\"section\":\"retention\",\"section_label\":\"Retention\",\"label\":\"Raw retention (days)\",\"type\":\"int\",\"help\":\"Default for new inputs. Per-input override stays on Inputs.\"},{\"key\":\"retention.export_days\",\"value\":\"15\",\"source\":\"db\",\"section\":\"retention\",\"section_label\":\"Retention\",\"label\":\"Export retention (days)\",\"type\":\"int\",\"help\":\"Unprotected exports. Protected exports are kept.\"},{\"key\":\"ffmpeg.path\",\"value\":\"/usr/local/bin/ffmpeg\",\"source\":\"db\",\"section\":\"ffmpeg\",\"section_label\":\"Recording / FFmpeg\",\"label\":\"ffmpeg path\",\"type\":\"path\",\"help\":\"setup.sh builds FFmpeg 9.0.2 here. Distro /usr/bin/ffmpeg is not the DeckLink build.\"},{\"key\":\"ffmpeg.probe\",\"value\":\"/usr/local/bin/ffprobe\",\"source\":\"db\",\"section\":\"ffmpeg\",\"section_label\":\"Recording / FFmpeg\",\"label\":\"ffprobe path\",\"type\":\"path\",\"help\":\"\"},{\"key\":\"ffmpeg.video_bitrate\",\"value\":\"12M\",\"source\":\"db\",\"section\":\"ffmpeg\",\"section_label\":\"Recording / FFmpeg\",\"label\":\"Broadcast video bitrate\",\"type\":\"bitrate\",\"help\":\"H.264 target when not copying a compressed IP bitstream.\"},{\"key\":\"ffmpeg.audio_bitrate\",\"value\":\"192k\",\"source\":\"db\",\"section\":\"ffmpeg\",\"section_label\":\"Recording / FFmpeg\",\"label\":\"Broadcast audio bitrate\",\"type\":\"bitrate\",\"help\":\"\"},{\"key\":\"ffmpeg.encoder\",\"value\":\"auto\",\"source\":\"db\",\"section\":\"ffmpeg\",\"section_label\":\"Recording / FFmpeg\",\"label\":\"Video encoder\",\"type\":\"enum\",\"help\":\"auto uses h264_nvenc when this user can open the NVIDIA device and ffmpeg lists that encoder. nvenc forces the GPU. libx264 stays on the CPU. Restart record, preview, and export after changing this.\",\"options\":[\"auto\",\"nvenc\",\"libx264\"]},{\"key\":\"ffmpeg.preset\",\"value\":\"veryfast\",\"source\":\"db\",\"section\":\"ffmpeg\",\"section_label\":\"Recording / FFmpeg\",\"label\":\"Encode preset\",\"type\":\"enum\",\"help\":\"Broadcast profile is H.264 High, yuv420p, AAC-LC. On the CPU these are x264 presets. On NVENC they map to p1\\u2013p7 (veryfast is p3).\",\"options\":[\"ultrafast\",\"superfast\",\"veryfast\",\"faster\",\"fast\",\"medium\",\"slow\"]},{\"key\":\"ffmpeg.segment_seconds\",\"value\":\"300\",\"source\":\"db\",\"section\":\"ffmpeg\",\"section_label\":\"Recording / FFmpeg\",\"label\":\"Segment length (minutes)\",\"type\":\"int\",\"help\":\"Wall-clock MP4 chunks. Production is 5 minutes. Applied when a record worker starts.\",\"ui\":\"minutes\"},{\"key\":\"ffmpeg.gop_frames\",\"value\":\"60\",\"source\":\"db\",\"section\":\"ffmpeg\",\"section_label\":\"Recording / FFmpeg\",\"label\":\"GOP (frames)\",\"type\":\"int\",\"help\":\"Closed GOP. 60 frames is about 2 seconds at 30 fps.\"},{\"key\":\"ffmpeg.decklink_status_bin\",\"value\":\"\",\"source\":\"db\",\"section\":\"ffmpeg\",\"section_label\":\"Recording / FFmpeg\",\"label\":\"DeckLink status helper\",\"type\":\"path\",\"help\":\"Absolute path to nexrec-decklink-status (no spaces). Blank also checks /usr/local/bin. Build tools/decklink-status against the Blackmagic SDK. JSON per sub-device: input_locked, input_mode, busy.\"},{\"key\":\"preview.enabled\",\"value\":\"1\",\"source\":\"db\",\"section\":\"preview\",\"section_label\":\"Preview / MediaMTX\",\"label\":\"Preview enabled\",\"type\":\"bool\",\"help\":\"\"},{\"key\":\"preview.mediamtx_rtsp\",\"value\":\"rtsp://127.0.0.1:8554\",\"source\":\"db\",\"section\":\"preview\",\"section_label\":\"Preview / MediaMTX\",\"label\":\"MediaMTX RTSP\",\"type\":\"url\",\"help\":\"FFmpeg publishes the proxy here. MediaMTX serves WHEP to browsers.\"},{\"key\":\"preview.whep_port\",\"value\":\"8889\",\"source\":\"db\",\"section\":\"preview\",\"section_label\":\"Preview / MediaMTX\",\"label\":\"WHEP port\",\"type\":\"int\",\"help\":\"\"},{\"key\":\"preview.whep_tls\",\"value\":\"0\",\"source\":\"db\",\"section\":\"preview\",\"section_label\":\"Preview / MediaMTX\",\"label\":\"WHEP TLS\",\"type\":\"bool\",\"help\":\"Off matches MediaMTX webrtcEncryption: no. Browsers then use http://host:8889. Turn on only after MediaMTX serves WHEP with TLS.\"},{\"key\":\"defaults.live_transcode\",\"value\":\"0\",\"source\":\"db\",\"section\":\"defaults\",\"section_label\":\"Defaults for new inputs\",\"label\":\"Live transcode\",\"type\":\"bool\",\"help\":\"Applied only when creating an input that does not send the field.\"},{\"key\":\"defaults.copy_native\",\"value\":\"1\",\"source\":\"db\",\"section\":\"defaults\",\"section_label\":\"Defaults for new inputs\",\"label\":\"Copy native bitstream\",\"type\":\"bool\",\"help\":\"\"},{\"key\":\"defaults.upconvert_1080i\",\"value\":\"0\",\"source\":\"db\",\"section\":\"defaults\",\"section_label\":\"Defaults for new inputs\",\"label\":\"Upconvert 1080i to 1080p\",\"type\":\"bool\",\"help\":\"The only upconvert the recorder will do.\"},{\"key\":\"defaults.preview_enabled\",\"value\":\"1\",\"source\":\"db\",\"section\":\"defaults\",\"section_label\":\"Defaults for new inputs\",\"label\":\"Preview on new inputs\",\"type\":\"bool\",\"help\":\"\"},{\"key\":\"defaults.max_inputs\",\"value\":\"10\",\"source\":\"db\",\"section\":\"defaults\",\"section_label\":\"Defaults for new inputs\",\"label\":\"Max inputs\",\"type\":\"int\",\"help\":\"\"},{\"key\":\"defaults.feat_scte\",\"value\":\"0\",\"source\":\"db\",\"section\":\"defaults\",\"section_label\":\"Defaults for new inputs\",\"label\":\"SCTE detection\",\"type\":\"bool\",\"help\":\"\"},{\"key\":\"defaults.feat_av_anomaly\",\"value\":\"0\",\"source\":\"db\",\"section\":\"defaults\",\"section_label\":\"Defaults for new inputs\",\"label\":\"Freeze / black / bars\",\"type\":\"bool\",\"help\":\"\"},{\"key\":\"defaults.feat_captions\",\"value\":\"0\",\"source\":\"db\",\"section\":\"defaults\",\"section_label\":\"Defaults for new inputs\",\"label\":\"Caption capture\",\"type\":\"bool\",\"help\":\"\"},{\"key\":\"defaults.feat_transcribe\",\"value\":\"0\",\"source\":\"db\",\"section\":\"defaults\",\"section_label\":\"Defaults for new inputs\",\"label\":\"Transcription\",\"type\":\"bool\",\"help\":\"\"},{\"key\":\"defaults.feat_nielsen\",\"value\":\"0\",\"source\":\"db\",\"section\":\"defaults\",\"section_label\":\"Defaults for new inputs\",\"label\":\"Nielsen presence check\",\"type\":\"bool\",\"help\":\"Presence-only until a licensed Nielsen SDK wrapper is configured below.\"},{\"key\":\"defaults.feat_monitors\",\"value\":\"0\",\"source\":\"db\",\"section\":\"defaults\",\"section_label\":\"Defaults for new inputs\",\"label\":\"Live confidence monitors\",\"type\":\"bool\",\"help\":\"Default for new inputs. Live WFM, vectorscope, VU, and 64-band RTA still default off in each browser and read the WHEP preview only. Does not change the record. 64-channel SDI/AES metering is not on the stereo AAC proxy.\"},{\"key\":\"nexapp.enabled\",\"value\":\"0\",\"source\":\"db\",\"section\":\"nexapp\",\"section_label\":\"NexAPP\",\"label\":\"NexAPP enabled\",\"type\":\"bool\",\"help\":\"\"},{\"key\":\"nexapp.mode\",\"value\":\"standalone\",\"source\":\"db\",\"section\":\"nexapp\",\"section_label\":\"NexAPP\",\"label\":\"Mode\",\"type\":\"enum\",\"help\":\"standalone: local login. alias: same-host NexAPP cookie. wan: launch ticket redeem. NexClip Mode 2 is separate.\",\"options\":[\"standalone\",\"alias\",\"wan\"]},{\"key\":\"nexapp.base_url\",\"value\":\"\",\"source\":\"db\",\"section\":\"nexapp\",\"section_label\":\"NexAPP\",\"label\":\"Base URL\",\"type\":\"url\",\"help\":\"Hub origin. Used when issuer is blank.\"},{\"key\":\"nexapp.issuer\",\"value\":\"\",\"source\":\"db\",\"section\":\"nexapp\",\"section_label\":\"NexAPP\",\"label\":\"Issuer\",\"type\":\"url\",\"help\":\"JWT iss. Usually the same origin as the base URL.\"},{\"key\":\"nexapp.service_id\",\"value\":\"nexclip-recorder-ctl1\",\"source\":\"db\",\"section\":\"nexapp\",\"section_label\":\"NexAPP\",\"label\":\"service_id\",\"type\":\"ident\",\"help\":\"One unique id per host. Do not share it with another recorder or a NexClip box.\"},{\"key\":\"nexapp.public_key_path\",\"value\":\"/var/www/nexapp/keys/jwt_public.pem\",\"source\":\"db\",\"section\":\"nexapp\",\"section_label\":\"NexAPP\",\"label\":\"JWT public key path\",\"type\":\"path\",\"help\":\"PEM file on disk. Paste a key below to write it under the data auth dir. The PEM is not stored in Postgres.\"},{\"key\":\"nexapp.access_url\",\"value\":\"\",\"source\":\"db\",\"section\":\"nexapp\",\"section_label\":\"NexAPP\",\"label\":\"Access URL\",\"type\":\"url\",\"help\":\"Blank derives {issuer}/api/access.php.\"},{\"key\":\"nexapp.redeem_url\",\"value\":\"\",\"source\":\"db\",\"section\":\"nexapp\",\"section_label\":\"NexAPP\",\"label\":\"WAN redeem URL\",\"type\":\"url\",\"help\":\"Blank derives {issuer}/api/launch/redeem.php.\"},{\"key\":\"nexapp.logout_url\",\"value\":\"\",\"source\":\"db\",\"section\":\"nexapp\",\"section_label\":\"NexAPP\",\"label\":\"Logout URL\",\"type\":\"url\",\"help\":\"\"},{\"key\":\"nexapp.wan_redeem_secret_ref\",\"value\":\"env:NEXAPP_LAUNCH_SECRET\",\"source\":\"db\",\"section\":\"nexapp\",\"section_label\":\"NexAPP\",\"label\":\"WAN redeem secret ref\",\"type\":\"secret_ref\",\"help\":\"Pointer only. The secret stays in nexrec.env (NEXAPP_LAUNCH_SECRET).\"},{\"key\":\"nexclip.enabled\",\"value\":\"0\",\"source\":\"db\",\"section\":\"nexclip\",\"section_label\":\"NexClip Mode 2\",\"label\":\"Mode 2 client enabled\",\"type\":\"bool\",\"help\":\"Export-request poll only. The calendar does not start or stop capture.\"},{\"key\":\"nexclip.api_base\",\"value\":\"\",\"source\":\"db\",\"section\":\"nexclip\",\"section_label\":\"NexClip Mode 2\",\"label\":\"API base\",\"type\":\"url\",\"help\":\"\"},{\"key\":\"nexclip.api_prefix\",\"value\":\"/api/v1\",\"source\":\"db\",\"section\":\"nexclip\",\"section_label\":\"NexClip Mode 2\",\"label\":\"API prefix\",\"type\":\"string\",\"help\":\"\"},{\"key\":\"nexclip.enrollment_secret_ref\",\"value\":\"env:NEXCLIP_ENROLLMENT_SECRET\",\"source\":\"db\",\"section\":\"nexclip\",\"section_label\":\"NexClip Mode 2\",\"label\":\"Enrollment secret ref\",\"type\":\"secret_ref\",\"help\":\"Pointer only. Set NEXCLIP_ENROLLMENT_SECRET in nexrec.env.\"},{\"key\":\"nexclip.recorder_id\",\"value\":\"\",\"source\":\"db\",\"section\":\"nexclip\",\"section_label\":\"NexClip Mode 2\",\"label\":\"recorder_id\",\"type\":\"string\",\"help\":\"Filled after the first successful register. Leave blank until then.\"},{\"key\":\"nexclip.poll_s\",\"value\":\"60\",\"source\":\"db\",\"section\":\"nexclip\",\"section_label\":\"NexClip Mode 2\",\"label\":\"Poll interval (seconds)\",\"type\":\"int\",\"help\":\"Operator-facing interval. nexrec-nexclip.timer is installed at 60s; change that unit if you need a different cadence.\"},{\"key\":\"nexclip.num_slots\",\"value\":\"8\",\"source\":\"db\",\"section\":\"nexclip\",\"section_label\":\"NexClip Mode 2\",\"label\":\"Mode 2 slots\",\"type\":\"int\",\"help\":\"\"},{\"key\":\"ldap.enabled\",\"value\":\"0\",\"source\":\"db\",\"section\":\"ldap\",\"section_label\":\"LDAP (local only)\",\"label\":\"LDAP enabled\",\"type\":\"bool\",\"help\":\"Recorder-local / air-gap only. Production Nex* uses local users and NexAPP, not hub LDAP.\"},{\"key\":\"ldap.url\",\"value\":\"\",\"source\":\"db\",\"section\":\"ldap\",\"section_label\":\"LDAP (local only)\",\"label\":\"LDAP URL\",\"type\":\"url\",\"help\":\"\"},{\"key\":\"ldap.bind_dn\",\"value\":\"\",\"source\":\"db\",\"section\":\"ldap\",\"section_label\":\"LDAP (local only)\",\"label\":\"Bind DN\",\"type\":\"string\",\"help\":\"\"},{\"key\":\"ldap.base_dn\",\"value\":\"\",\"source\":\"db\",\"section\":\"ldap\",\"section_label\":\"LDAP (local only)\",\"label\":\"Base DN\",\"type\":\"string\",\"help\":\"\"},{\"key\":\"ldap.user_filter\",\"value\":\"(uid=%s)\",\"source\":\"db\",\"section\":\"ldap\",\"section_label\":\"LDAP (local only)\",\"label\":\"User filter\",\"type\":\"string\",\"help\":\"\"},{\"key\":\"ldap.email_attr\",\"value\":\"mail\",\"source\":\"db\",\"section\":\"ldap\",\"section_label\":\"LDAP (local only)\",\"label\":\"Email attribute\",\"type\":\"string\",\"help\":\"\"},{\"key\":\"ldap.display_attr\",\"value\":\"cn\",\"source\":\"db\",\"section\":\"ldap\",\"section_label\":\"LDAP (local only)\",\"label\":\"Display attribute\",\"type\":\"string\",\"help\":\"\"},{\"key\":\"intelligence.transcribe_engine\",\"value\":\"none\",\"source\":\"db\",\"section\":\"intelligence\",\"section_label\":\"Monitoring engines\",\"label\":\"Transcribe engine\",\"type\":\"enum\",\"help\":\"\",\"options\":[\"none\",\"whisper.cpp\",\"faster-whisper\"]},{\"key\":\"intelligence.transcribe_cmd\",\"value\":\"\",\"source\":\"db\",\"section\":\"intelligence\",\"section_label\":\"Monitoring engines\",\"label\":\"Transcribe command\",\"type\":\"command\",\"help\":\"Template with {input} and {output}. Empty leaves transcription off.\"},{\"key\":\"intelligence.transcribe_timeout_s\",\"value\":\"300\",\"source\":\"db\",\"section\":\"intelligence\",\"section_label\":\"Monitoring engines\",\"label\":\"Transcribe timeout (s)\",\"type\":\"int\",\"help\":\"\"},{\"key\":\"intelligence.loudness_timeout_s\",\"value\":\"180\",\"source\":\"db\",\"section\":\"intelligence\",\"section_label\":\"Monitoring engines\",\"label\":\"Loudness timeout (s)\",\"type\":\"int\",\"help\":\"\"},{\"key\":\"intelligence.nielsen_cmd\",\"value\":\"\",\"source\":\"db\",\"section\":\"intelligence\",\"section_label\":\"Monitoring engines\",\"label\":\"Nielsen presence command\",\"type\":\"command\",\"help\":\"Optional best-effort presence command with {input}, {output}, and optional {duration}. Blank keeps the builtin stub.\"}],\"secrets\":[{\"key\":\"NEXREC_PGPASSWORD\",\"note\":\"PostgreSQL password (bootstrap secret)\",\"set\":true},{\"key\":\"NEXREC_DATA_DIR\",\"note\":\"Data directory (bootstrap)\",\"set\":true},{\"key\":\"NEXREC_ADMIN_USER\",\"note\":\"Initial local admin (first boot only)\",\"set\":true},{\"key\":\"NEXREC_ADMIN_PASSWORD\",\"note\":\"Initial local admin password (first boot only)\",\"set\":true},{\"key\":\"NEXREC_API_KEY\",\"note\":\"Recorder API key\",\"set\":false},{\"key\":\"NEXREC_LDAP_BIND_PASSWORD\",\"note\":\"LDAP bind password\",\"set\":false},{\"key\":\"NEXAPP_LAUNCH_SECRET\",\"note\":\"WAN launch redeem secret\",\"set\":false},{\"key\":\"NEXCLIP_ENROLLMENT_SECRET\",\"note\":\"NexClip Mode 2 enrollment secret\",\"set\":false},{\"key\":\"NEXCLIP_API_KEY\",\"note\":\"Legacy NexClip API key\",\"set\":false},{\"key\":\"NEXCLIP_NODE_TOKEN\",\"note\":\"NexClip node bearer after register\",\"set\":false},{\"key\":\"NEXREC_PUBLISH_JWT\",\"note\":\"MediaMTX publish JWT\",\"set\":false},{\"key\":\"NEXREC_HTTP_PORT\",\"note\":\"HTTP listen port (process bootstrap)\",\"set\":true},{\"key\":\"NEXREC_ALLOW_HTTP\",\"note\":\"Allow plain HTTP (demo bootstrap)\",\"set\":true}],\"policy\":\"Day-to-day settings live in Postgres app_settings (this page). nexrec.env is bootstrap and secrets only, including the database password. Set NEXREC_ENV_OVERRIDES=1 to let the env file win for one boot.\",\"can_edit\":true}"
