# NexCLIP Recorder — bootstrap and secrets only.
# Installed as /etc/nexrec/nexrec.env by setup.sh when that file is absent.
# Sourced by systemd. Quote values that contain spaces. Never commit real secrets.
#
# Day-to-day admin (paths, retention, bitrates, NexAPP/NexClip endpoints,
# preview, feature defaults, Nielsen command path) is the Setup page
# (/settings), stored in PostgreSQL app_settings. First boot copies defaults
# (and any of these keys if you still set them) into that table once.
# After that the database wins.
#
# Break-glass: NEXREC_ENV_OVERRIDES=1 makes this file win over app_settings
# for one boot. Leave it unset on a normal station.

# --- Bootstrap (process must know where data and Postgres live) --------------
NEXREC_DATA_DIR=/var/lib/nexrec
NEXREC_AUTH_DIR=/var/lib/nexrec/auth

# Local PostgreSQL on this recorder. setup.sh creates the role and database.
# The password is a secret and is filled in on first setup (openssl rand).
# Setup shows host, port, database, and user; a running process still reads
# this file. Edit it and restart units to retarget the server.
NEXREC_PGHOST=127.0.0.1
NEXREC_PGPORT=5432
NEXREC_PGDATABASE=nexrec
NEXREC_PGUSER=nexrec
NEXREC_PGPASSWORD=

# HTTP listen is process bootstrap, not a Setup field.
NEXREC_HTTP_PORT=8080
# Set to 1 to skip HTTPS redirect (local php -S demo).
NEXREC_ALLOW_HTTP=1

# --- Initial local admin (used only when the users table is empty) -----------
# Change immediately. Never commit a real password.
NEXREC_ADMIN_USER=admin
NEXREC_ADMIN_PASSWORD=password

# --- Secrets (never stored in app_settings) ----------------------------------
# NEXREC_API_KEY=
# NEXREC_LDAP_BIND_PASSWORD=
# NEXAPP_LAUNCH_SECRET=
# NEXCLIP_ENROLLMENT_SECRET=
# NEXCLIP_API_KEY=
# NEXCLIP_NODE_TOKEN=
# NEXREC_PUBLISH_JWT=

# setup.sh installs /usr/local/bin/ffmpeg (FFmpeg 9.0.2) and MediaMTX v1.21.1.
# Setup defaults ffmpeg.path to that binary. Distro /usr/bin/ffmpeg is not used
# for DeckLink. NEXREC_FORCE_FFMPEG_BUILD=1 rebuilds. SDK headers: DECKLINK_SDK.
#
# Optional absolute path of the DeckLink status helper (no spaces).
# Preferred stdout is JSON: {"devices":[{"index":0,"name":"DeckLink Quad 2 (1)",
#   "input_locked":true,"input_mode":"1080i59.94","reference_locked":false,
#   "reference_mode":"unknown","busy":false}]}
# Build: tools/decklink-status (Blackmagic SDK). /usr/local/bin is also searched.
# Key/value stdout (signal=, lock=, format=) is still accepted.
# Day-to-day path can also be set on Setup (ffmpeg.decklink_status_bin).
# Without a helper, Services shows "unknown — needs DeckLink tools".
# NEXREC_DECKLINK_STATUS_BIN=

# --- Intelligence engines (optional; no secrets) ------------------------------
# Per-input FEAT_* flags in inputs-example.env. Station-wide engine defaults:
# none | whisper.cpp | faster-whisper  (command must be installed separately)
NEXREC_TRANSCRIBE_ENGINE=none
# Template. Must write JSON [{t_start,t_end,speaker,text},...] to {output}.
# NEXREC_TRANSCRIBE_CMD=/usr/local/bin/whisper-cli -f {input} --output {output}
# NEXREC_TRANSCRIBE_TIMEOUT_S=300
# Optional Nielsen *presence* command (not a decoder, not the Nielsen SDK).
# Leave unset to use the builtin stub (worker/nexrec_nielsen.py), which logs
# present/absent over the chunk timeline. Not audit-grade. The command writes
# JSON [{pts,pts_end,present},...] to {output}. sid/layer/timestamp are ignored.
# NEXREC_NIELSEN_PRESENCE_CMD=/usr/local/bin/nielsen-presence {input} {output}
# NEXREC_NIELSEN_WINDOW_S=30
# NEXREC_NIELSEN_TIMEOUT_S=60
NEXREC_LOUDNESS_TIMEOUT_S=180
