# NexCLIP Recorder station-wide config — installed as /etc/nexrec/nexrec.env
#
# Sourced by systemd units (bash). Quote values that contain spaces.
# setup.sh installs this file only when absent (never overwrites live config).
# Copy to nexrec.env for a local demo; never commit secrets.

# --- Identity / deploy mode ---------------------------------------------------
# standalone | nexapp-wan | nexclip-worker  (more than one may be true;
# NEXREC_DEPLOY_MODE is the primary UX: standalone still accepts NexAPP SSO
# when NEXAPP_* is set.)
NEXREC_DEPLOY_MODE=standalone
# Hostname / display for this box (NexClip register `hostname`). Not a NexAPP
# grant key — each host uses a unique NEXAPP_SERVICE_ID instead.
NEXREC_INSTANCE_ID=dcwasof2nexrec01
NEXREC_INSTANCE_NAME="Studio Recorder 01"
NEXREC_PUBLIC_URL=https://recorder.example.internal

# --- Paths --------------------------------------------------------------------
NEXREC_DATA_DIR=/var/lib/nexrec
NEXREC_STORAGE_DIR=/var/lib/nexrec/storage
NEXREC_DB=/var/lib/nexrec/nexrec.db
NEXREC_AUTH_DIR=/var/lib/nexrec/auth
NEXREC_FFMPEG=/usr/bin/ffmpeg
NEXREC_FFPROBE=/usr/bin/ffprobe

# Keep at least this much free on the storage filesystem. Cleanup deletes
# unprotected exports first, then oldest unprotected/orphan native chunks.
# Accepts integer bytes, or a number with K/M/G suffix (e.g. 50G).
NEXREC_FREE_SPACE_FLOOR=50G

# --- Recording ----------------------------------------------------------------
# Production segment length is 300s (5 minutes), wall-clock aligned.
# Tests/demo may set 5.
NEXREC_SEGMENT_SECONDS=300
# Default native recording retention (days). Overridable per input.
NEXREC_NATIVE_RETENTION_DAYS=28
# Unprotected exports expire after this many days.
NEXREC_EXPORT_RETENTION_DAYS=15
# H.264 "best broadcast" bitrate used when not copying a compressed IP stream.
NEXREC_BROADCAST_VIDEO_BITRATE=12M
NEXREC_BROADCAST_AUDIO_BITRATE=192k
# GOP in frames (2s at 30fps). Edit-friendly for Premiere / FCPX.
NEXREC_GOP_FRAMES=60
NEXREC_X264_PRESET=veryfast
NEXREC_TIMEZONE=America/New_York
# Max concurrent ingest slots on this host.
NEXREC_MAX_INPUTS=10

# --- Preview (MediaMTX WHEP, same idea as NexVUE) -----------------------------
NEXREC_PREVIEW_ENABLED=1
NEXREC_MEDIAMTX_RTSP=rtsp://127.0.0.1:8554
NEXREC_WHEP_PORT=8889
# Long-lived MediaMTX publish JWT (written by auth bootstrap). Example only:
# NEXREC_PUBLISH_JWT=

# --- Local auth ---------------------------------------------------------------
# Seeded by setup.sh / nexrec-auth-bootstrap.php when no users exist.
# Change immediately. Never commit a real password.
NEXREC_ADMIN_USER=admin
NEXREC_ADMIN_PASSWORD=password
NEXREC_API_KEY=

# --- LDAP (optional, recorder-local only) ------------------------------------
# NexAPP hub auth is local + Entra SAML, not LDAP. NexClip removed LDAP.
# Leave 0 in production Nex* deployments. Enable only for air-gapped standalone.
NEXREC_LDAP_ENABLED=0
NEXREC_LDAP_URL=ldaps://ldap.example.internal:636
NEXREC_LDAP_BIND_DN=cn=nexrec,ou=services,dc=example,dc=internal
# NEXREC_LDAP_BIND_PASSWORD=
NEXREC_LDAP_BASE_DN=ou=people,dc=example,dc=internal
NEXREC_LDAP_USER_FILTER=(uid=%s)
NEXREC_LDAP_EMAIL_ATTR=mail
NEXREC_LDAP_DISPLAY_ATTR=cn
# Optional group DN; members get operator (default) or NEXREC_LDAP_ADMIN_GROUP.
# NEXREC_LDAP_OPERATOR_GROUP=
# NEXREC_LDAP_ADMIN_GROUP=

# --- NexAPP Authentication / SSO ----------------------------------------------
# Same-host Alias (lab): RS256 JWT cookie NexAPP_AUTH + AccessService / access.php.
# WAN (primary): launch.php?service_id= → POST /api/launch/redeem.php
#   with X-NexApp-Launch-Secret.
#
# NexAPP convention (Recorder and standalone NexClip alike): one unique
# service_id per host. Register each box in NexAPP Admin:
#   catalog service_id + HTTPS launch URL, config.php
#   launch.redeem_secrets.<service_id>, Access grants for that id, manifest.
# Do not share a service_id across machines. No instance_id grant gate.
# NexAPP never connects into this box.
NEXREC_NEXAPP_ENABLED=0
NEXAPP_ISSUER=https://nexapp.example.internal
NEXAPP_PUBLIC_KEY_PATH=/var/www/nexapp/keys/jwt_public.pem
NEXAPP_ROOT=/var/www/nexapp
NEXAPP_ACCESS_URL=https://nexapp.example.internal/api/access.php
NEXAPP_SERVICE_ID=nexclip-recorder-ctl1
# WAN redeem (NEXAPP/examples/nexapp-launch-redeem.php)
NEXAPP_REDEEM_URL=https://nexapp.example.internal/api/launch/redeem.php
# NEXAPP_LAUNCH_SECRET=
NEXAPP_LOGOUT_URL=https://nexapp.example.internal/logout.php

# --- NexClip Mode 2 node (continuous_24x7 export requests) -------------------
# Mode 2 ONLY. Calendar does NOT start/stop capture. Mode 1 schedule-poll /
# safety_net is out of scope. Enrollment secret + bearer, not NexAPP.
NEXREC_NEXCLIP_ENABLED=0
NEXCLIP_BASE_URL=https://nexclip.example.internal
NEXCLIP_API_PREFIX=/api/v1
# NEXCLIP_ENROLLMENT_SECRET=
# Optional after first register:
# NEXCLIP_RECORDER_ID=
# NEXCLIP_NODE_TOKEN=
# decklink | srt | ndi  (RTSP/UDP/RTP map to srt — enum gap)
# NEXCLIP_RECORDER_TYPE=srt
NEXCLIP_NUM_SLOTS=8
# Poll interval is systemd nexrec-nexclip.timer (default 60s).

# --- HTTP ---------------------------------------------------------------------
NEXREC_HTTP_PORT=8080
# Set to 1 to skip HTTPS redirect (local php -S demo).
NEXREC_ALLOW_HTTP=1

# --- Intelligence engines (optional; no secrets) ------------------------------
# Per-input FEAT_* flags in inputs-example.env. Station-wide engine defaults:
# none | whisper.cpp | faster-whisper  (command must be installed separately)
NEXREC_TRANSCRIBE_ENGINE=none
# Template. Must write JSON [{t_start,t_end,speaker,text},...] to {output}.
# NEXREC_TRANSCRIBE_CMD=/usr/local/bin/whisper-cli -f {input} --output {output}
# NEXREC_TRANSCRIBE_TIMEOUT_S=300
# Licensed Nielsen Audio Decoder SDK (not in FFmpeg). Leave unset to stub.
# NEXREC_NIELSEN_CMD=
NEXREC_LOUDNESS_TIMEOUT_S=180
