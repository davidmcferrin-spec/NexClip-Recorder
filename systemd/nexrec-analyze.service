[Unit]
Description=NexCLIP Recorder sidecar analyze (LKFS / optional chunk jobs)
After=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/nexrec/nexrec.env
ExecStart=/usr/bin/python3 /opt/NexClip-Recorder/worker/nexrec-analyze.py --env /etc/nexrec/nexrec.env --loop
Restart=always
RestartSec=5
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
