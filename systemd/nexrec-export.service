[Unit]
Description=NexCLIP Recorder export queue
After=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/nexrec/nexrec.env
ExecStart=/usr/bin/python3 /opt/NexClip-Recorder/worker/nexrec-export.py --env /etc/nexrec/nexrec.env
Restart=always
RestartSec=3
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
